// ~/.claude/hooks/router.mjs — always-on UserPromptSubmit hook skeleton.
//
// Caveman coexistence boundary (D-12):
//   caveman's plugin-scoped `caveman-mode-tracker.js` and this router both fire
//   in parallel as separate `UserPromptSubmit` hooks. Their `additionalContext`
//   strings accumulate (Claude receives both). Router owns "what should run";
//   caveman owns "what mode is active". Router NEVER reads, parses, modifies,
//   or strips caveman's output block. The router sentinel
//   `<!-- router-inject -->` is lexically distinct from caveman's plain-text
//   output (caveman emits no HTML comments — confirmed by reading
//   caveman-mode-tracker.js).
//
// Fail-open policy (D-02):
//   On any internal throw, exit 0 with no additionalContext (the original prompt
//   passes through unchanged). NEVER exit code 2, NEVER emit a block decision — that
//   would erase the user's prompt. Each pipeline step degrades independently;
//   the outer try/catch is the belt-and-braces backstop.
//
// This plan (01-01) ships the fail-open skeleton only — no BM25, no mode-map,
// no injection, no cache, no telemetry. Subsequent plans slot routing logic
// into a pipeline that is already provably non-blocking and coexistence-safe.

import { readFileSync, writeFileSync, writeSync, existsSync, statSync, renameSync, appendFileSync, chmodSync, mkdirSync } from 'node:fs';
import { createHash } from 'node:crypto';
import { homedir } from 'node:os';
import { join } from 'node:path';
import { fileURLToPath, pathToFileURL } from 'node:url';
import { spawn } from 'node:child_process';
import { createRequire } from 'node:module';
let correlateOutcomes;
let aggregatePerEntry;
let proposeAdditions;
let proposeEdits;
let proposePrunes;

// ESM->CJS bridge for the gsd-surface primitive lazy-required from applySurfaceFilter.
// Resolves relative to this file (router.mjs), not process.cwd() — safe across
// symlink layouts. The three CJS modules are required lazily on first use of
// applySurfaceFilter (Pitfall 3 / D-04). Sentinel `false` = unimportable.
// Use absolute paths under RUNTIME_CONFIG_DIR (resolved above) because Node's
// module resolution from ~/.claude/hooks/router.mjs has no node_modules in
// its lookup chain — a bare specifier like 'gsd-core/bin/lib/surface.cjs'
// would silently fail at runtime (RESEARCH Pitfall 3). The SKILL.md shows
// the bare specifier as a documentation example; the actual runtime pattern
// is absolute-path require, which is what this code does.
const _require = createRequire(import.meta.url);
let _surfaceMod = null;
let _clustersMod = null;
let _registryMod = null;

// Run the entry point only when this file is executed directly (as a hook),
// not when imported as a module by tests. Without this guard, `await import()`
// in a test would attach stdin listeners that never close and hang the runner.
const isMain = () => {
  try {
    return import.meta.url === pathToFileURL(process.argv[1]).href
      || process.argv[1]?.endsWith('/router.mjs');
  } catch {
    return false;
  }
};

const proposalCommands = new Set(['proposals', 'proposal', 'evolve-proposals']);
if (!isMain() || proposalCommands.has(process.argv[2])) {
  ({
    correlateOutcomes,
    aggregatePerEntry,
    proposeAdditions,
    proposeEdits,
    proposePrunes,
  } = await import('./router.evolve.mjs'));
}

// --- Runtime detection (PARITY-01 / D-01 / D-02 / D-04) --------------------
// detectRuntime() runs ONCE at module load and caches into RUNTIME (D-01) —
// zero hot-path IO, zero per-prompt branching. Precedence: (1) ROUTER_RUNTIME
// env override wins when exactly 'claude'|'codex' (D-04); (2) else a codex
// marker (CODEX_HOME set, or argv[1] path under .codex/) → 'codex'; (3) else
// default 'claude' (deterministic fail-open). Out-of-enum ROUTER_RUNTIME
// clamps to 'claude' (T-31-01) — an unbounded string never reaches path
// construction. Uses only process.env/process.argv string checks already in
// scope at module load — NO IO, NO existsSync.
export function detectRuntime() {
  try {
    const override = process.env.ROUTER_RUNTIME;
    if (override === 'claude' || override === 'codex') return override;
    if (process.env.CODEX_HOME || String(process.argv[1] || '').includes('.codex/')) return 'codex';
    return 'claude';
  } catch {
    return 'claude';
  }
}
export const RUNTIME = detectRuntime();
// D-03: ONE runtime-conditional root is the single source of truth for the
// profile dir. claude → ~/.claude, codex → ~/.codex. All data paths derive
// from RUNTIME_CONFIG_DIR, so tagging the root isolates data per runtime.
const runtimeBaseDir = (runtime) => join(homedir(), '.' + runtime);

// --- Constants (no /Users/guilherme hardcoding — use os.homedir()) ---------
export const RUNTIME_CONFIG_DIR = runtimeBaseDir(RUNTIME);
const ROUTER_DIR = join(RUNTIME_CONFIG_DIR, 'router');
const MANIFEST = join(ROUTER_DIR, 'claude-inventory-manifest.json');
const BUILD_SCRIPT = join(ROUTER_DIR, 'build-manifest.mjs');
const COVERAGE_REPORT = join(ROUTER_DIR, 'coverage-report.json');
const CACHE = join(ROUTER_DIR, 'cache.json');
const TELEMETRY = join(ROUTER_DIR, 'telemetry.jsonl');
const SHADOW_LOG = join(ROUTER_DIR, 'shadow-log.jsonl');
const SHADOW_STATE = join(ROUTER_DIR, 'shadow-state.json');
const MODE_MAP = join(ROUTER_DIR, 'mode-map.json');
const WEIGHTS = join(ROUTER_DIR, 'weights.json');
// INVC-03: per-install calibration FILE (created by Phase 34). The hook only
// ever reads it epoch-gated — a matching manifest_fingerprint wins, and any
// mismatch/absence/corruption falls back to mode-map defaults. Never mutated.
const CALIBRATION_PATH = join(ROUTER_DIR, 'calibration.json');
// Phase 3 / EVO-02/EVO-03 evolution worker plumbing.
const EVOLUTION_STATE = join(ROUTER_DIR, 'evolution-state.json');
const TRIGGER = join(ROUTER_DIR, '.evolve-trigger');
const HOOKS_DIR = join(RUNTIME_CONFIG_DIR, 'hooks');
const WORKER_PATH = join(HOOKS_DIR, 'router.evolve.mjs');
const EVOLVE_TRIGGER_N = 200;

// Phase 4 / ANC-01: surface filter plumbing. RUNTIME_CONFIG_DIR is the home of
// the user's `.gsd-surface.json` state file (sibling of `~/.claude/router/`).
// SURFACE_FILE is the cache-key path (mtime only — never read directly; the
// router always goes through surface.cjs:resolveSurface per D-03).
// GSD_CORE_DIR is the absolute path to the gsd-core engine lib dir, used as
// the require target for surface.cjs / clusters.cjs / capability-registry.cjs.
// Bare-specifier requires like 'gsd-core/bin/lib/surface.cjs' would silently
// fail (RESEARCH Pitfall 3) because ~/.claude/hooks/router.mjs has no
// node_modules in its resolution chain. Absolute-path require is the runtime
// pattern used by gsd-surface itself in production.
const SURFACE_FILE = join(RUNTIME_CONFIG_DIR, '.gsd-surface.json');
const GSD_CORE_DIR = join(RUNTIME_CONFIG_DIR, 'gsd-core', 'bin', 'lib');

// Lazy require getters. Each caches its result (or the sentinel `false`) so
// the per-prompt cost is one Map lookup after the first call. surface.cjs and
// clusters.cjs are required together (both mandatory for resolveSurface);
// capability-registry.cjs is optional (the helper still works without it).
function getSurfaceMod() {
  if (_surfaceMod === null) {
    try { _surfaceMod = _require(join(GSD_CORE_DIR, 'surface.cjs')); }
    catch (_) { _surfaceMod = false; }
  }
  return _surfaceMod || null;
}
function getClustersMod() {
  if (_clustersMod === null) {
    try { _clustersMod = _require(join(GSD_CORE_DIR, 'clusters.cjs')); }
    catch (_) { _clustersMod = false; }
  }
  return _clustersMod || null;
}
function getRegistryMod() {
  if (_registryMod === null) {
    try { _registryMod = _require(join(GSD_CORE_DIR, 'capability-registry.cjs')); }
    catch (_) { _registryMod = false; }
  }
  return _registryMod || null;
}

// Phase 4 / ANC-01: post-filter on buildCorpus output via gsd-surface's
// resolveSurface (D-01..D-08). The router NEVER reads or parses
// .gsd-surface.json directly (D-03) — every read goes through
// surfaceMod.resolveSurface. Fail-open: any throw or missing module
// returns the input corpus unchanged with surface_status='absent'.
// Mtime-keyed in-process cache, per-runtimeConfigDir (D-07): sub-ms warm, <5ms cold.

// Transform the router's inventory manifest ({ skills:[], agents:[], ... })
// into a stem-dep map ({ [stem]: requires[] }) that surface.cjs's
// normalizeSkillManifest understands. The inventory manifest is the
// canonical record of WHAT EXISTS on the user's machine (D-02 / RTE-01);
// surface.cjs needs to know WHAT each stem requires to compute
// transitive closure on explicitAdds. The router doesn't track requires
// in its inventory, so the value is `[]` for every stem — sufficient for
// the disable-ability use case (cluster → set of stems → drop from
// enabled set) and for the base-profile resolution. Pure + local.
function _inventoryToStemMap(manifest) {
  if (!manifest || typeof manifest !== 'object') return {};
  const out = {};
  const lists = ['skills', 'plugin_skills', 'agents_store_skills', 'project_scoped_skills', 'agents', 'commands'];
  for (const key of lists) {
    const arr = Array.isArray(manifest[key]) ? manifest[key] : [];
    for (const e of arr) {
      if (!e || !e.name) continue;
      const stem = String(e.name);
      if (!(stem in out)) out[stem] = [];
    }
  }
  return out;
}

const _surfaceCaches = new Map(); // runtimeConfigDir -> { mtimeMs, enabledSet, surfaceStatus, disabledCount }
export function _resetSurfaceCache() {
  _surfaceCaches.clear();
}
function _getCache(runtimeConfigDir) {
  let c = _surfaceCaches.get(runtimeConfigDir);
  if (!c) {
    c = { mtimeMs: 0, enabledSet: null, surfaceStatus: 'unconfigured', disabledCount: 0 };
    _surfaceCaches.set(runtimeConfigDir, c);
  }
  return c;
}
// Phase 4 / ANC-01: test-only accessor for the mtime cache. Exported with
// the `_` prefix per the "internal" convention so production callers do
// not depend on the cache shape. Used by tests/router.ancestor-reuse.test.mjs
// (Test 6/7) to assert that the warm path reuses the same Set reference
// and the cold path produces a different one after mtime change.
export function _getSurfaceCacheForTest(runtimeConfigDir) {
  return _surfaceCaches.get(runtimeConfigDir) || null;
}
// Phase 4 / ANC-01: test-only hook to force the module sentinels into the
// "unimportable" state. Used by tests/router.ancestor-reuse.test.mjs
// (Test 2) to exercise the load-bearing fail-open path
// (surface_status='absent') without needing to actually delete the
// user's gsd-core install. Pass `true` to force absence, `false` to
// restore normal behavior.
export function _setModulesUnimportableForTest(absent) {
  if (absent) {
    _surfaceMod = false;
    _clustersMod = false;
    _registryMod = false;
  } else {
    _surfaceMod = null;
    _clustersMod = null;
    _registryMod = null;
  }
}

// applySurfaceFilter(corpus, manifest, modeMap, runtimeConfigDir = RUNTIME_CONFIG_DIR)
//   -> { corpus, surface_status, surface_disabled_count }
//
// CRITICAL (RESEARCH Pitfall 1): the `manifest` passed to resolveSurface is the
// RAW manifest object (the stem-dep map shape), NOT the corpus (which is the
// BM25-doc shape). Passing the corpus to resolveSurface would make
// normalizeSkillManifest return an empty Map, silently filtering out ALL
// corpus entries. modeMap is accepted but unused (symmetry with buildCorpus
// + future-proofing for Phase 5+ surface-aware rules per RESEARCH §2).
export function applySurfaceFilter(corpus, manifest, modeMap, runtimeConfigDir = RUNTIME_CONFIG_DIR) {
  // Default branch: empty corpus, no work to do.
  if (!Array.isArray(corpus) || corpus.length === 0) {
    return { corpus, surface_status: 'unconfigured', surface_disabled_count: 0 };
  }
  // Outer try/catch = fail-open belt-and-braces (D-06 / Phase-1 D-02).
  try {
    const surfaceMod = getSurfaceMod();
    const clustersMod = getClustersMod();
    const registryMod = getRegistryMod();
    // Module-sentinel fail-open: both surfaceMod and clustersMod are mandatory
    // for resolveSurface. If either is unimportable, return the input corpus
    // unchanged with surface_status='absent' (D-08: 'absent' = the gsd-core
    // modules are missing). Note: this does NOT cache the absent verdict —
    // module availability is rechecked on every call so a later gsd-core
    // install would still be picked up (cheap: one try/catch + sentinel read).
    if (!surfaceMod || !clustersMod) {
      return { corpus, surface_status: 'absent', surface_disabled_count: 0 };
    }

    const cache = _getCache(runtimeConfigDir);
    const surfaceFile = join(runtimeConfigDir, '.gsd-surface.json');
    // Mtime check (sub-ms). file missing → mtime 0 → cache miss → cold path
    // → resolveSurface reads .gsd-profile and falls through to 'full' default.
    let mtime = 0;
    try { mtime = statSync(surfaceFile).mtimeMs; } catch (_) { /* missing */ }
    const cacheHit = mtime === cache.mtimeMs && cache.enabledSet !== null;
    if (!cacheHit) {
      cache.mtimeMs = mtime;
      // Cold path: call resolveSurface. On any throw → set sentinel, return.
      // The router's inventory manifest is the { skills:[], agents:[], ... }
      // shape; surface.cjs's normalizeSkillManifest expects a stem-dep map
      // (Map<stem, requires[]> or { [stem]: string[] }). We transform the
      // inventory into the stem-dep shape inline so resolveSurface can match
      // names against the cluster map. The requires[] for each stem is empty
      // (we don't track deps in the router's manifest) — sufficient for
      // enable/disable by cluster name + transitive closure on explicitAdds.
      const stemMap = _inventoryToStemMap(manifest);
      let resolved;
      try {
        resolved = surfaceMod.resolveSurface(
          runtimeConfigDir, stemMap, clustersMod.CLUSTERS, registryMod || undefined
        );
      } catch (_) {
        // resolveSurface threw (malformed manifest, etc.) — fail-open.
        cache.enabledSet = new Set();
        cache.surfaceStatus = 'absent';
        cache.disabledCount = 0;
        return { corpus, surface_status: 'absent', surface_disabled_count: 0 };
      }
      // Defensive type-check: resolved.skills is documented as Set<string> but
      // tolerate a future shape change (Array, etc.) by normalizing to a Set.
      cache.enabledSet = resolved && resolved.skills instanceof Set
        ? resolved.skills
        : new Set(resolved && resolved.skills ? resolved.skills : []);
      // Decide status. readSurface returns null on parse error or missing
      // file — that is the canonical "no valid surface state" signal
      // (D-08: 'unconfigured' = no .gsd-surface.json OR no .gsd-profile; the
      // router used the full manifest). existsSync alone is not sufficient:
      // a corrupt-but-present file would falsely report 'applied' even
      // though resolveSurface fell through to the .gsd-profile/'full'
      // default (line 79 of surface.cjs returns null on JSON.parse error).
      let surfaceStateValid = false;
      try {
        surfaceStateValid = !!(surfaceMod && surfaceMod.readSurface
          && surfaceMod.readSurface(runtimeConfigDir));
      } catch (_) { surfaceStateValid = false; }
      cache.surfaceStatus = surfaceStateValid ? 'applied' : 'unconfigured';
      // Disabled count is computed AFTER the filter pass below — the
      // authoritative count is `corpus.length - filtered.length` (matches
      // what the user actually sees in the routing output), not a manifest
      // math derivation. We seed it to 0 here and overwrite in the filter
      // pass.
      cache.disabledCount = 0;
    }

    // Filter pass — runs on every call (both warm and cold). The Set lookup
    // is the only per-corpus-entry cost; well under 1ms for ~244 entries.
    const enabledSet = cache.enabledSet;
    if (enabledSet.size === 0) {
      // Empty Set = first-call failure (or surface.cjs returned an empty set).
      // Pass through unchanged — this is fail-open semantics for the
      // degenerate case where surface.cjs is importable but resolveSurface
      // returned nothing usable. Status reflects what the cache decided.
      return {
        corpus,
        surface_status: cache.surfaceStatus,
        surface_disabled_count: 0,
      };
    }
    const filtered = corpus.filter((c) => enabledSet.has(String(c.name || '')));
    // Recompute disabledCount on the cold path: this is the authoritative
    // count of "stems the user can't route to" (corpus before vs after
    // the surface filter). Cached value persists for the warm path.
    if (!cacheHit) cache.disabledCount = Math.max(0, corpus.length - filtered.length);
    return {
      corpus: filtered,
      surface_status: cache.surfaceStatus,
      surface_disabled_count: cache.disabledCount,
    };
  } catch (_) {
    // Outer try/catch belt-and-braces: any throw in this helper returns
    // the input corpus unchanged with 'absent' (D-06 fail-open contract).
    return { corpus, surface_status: 'absent', surface_disabled_count: 0 };
  }
}

export const SENTINEL = '<!-- router-inject -->';

const STALE_MS = 7 * 24 * 3600 * 1000; // 7 days
const STALE_REMINDER =
  '<!-- router: manifest may be stale — run: node ~/.claude/router/build-manifest.mjs -->';
const COVERAGE_REMINDER =
  '<!-- router: coverage report may be stale — run: node ~/.claude/router/build-manifest.mjs -->';

const TRIVIAL = new Set([
  'thanks', 'ok', 'great', 'cool', 'nice', 'yes', 'no', 'done', 'sgtm',
]);

// --- Pure helpers (exported for direct unit testing) ----------------------

// True for empty/whitespace-only prompts or a small set of trivial phrases.
// Used as a pass-through short-circuit BEFORE any routing.
export function trivialPromptDetect(prompt) {
  if (typeof prompt !== 'string') return true;
  const trimmed = prompt.trim();
  if (trimmed === '') return true;
  return TRIVIAL.has(trimmed.toLowerCase());
}

// Explicit user override (GRD-04). The /-prefix half ships in Plan 01; the
// named-skill/mode half is completed here in Plan 03 (it needs mode-map's
// known-names list). Returns {override:true, reason:"user_explicit"} when the
// prompt starts with `/` after trim OR contains a known mode-map skill/mode
// name as a whole-word token. Cheap, authoritative, runs BEFORE any routing.
export function explicitOverrideDetect(prompt, knownNames = null) {
  if (typeof prompt !== 'string') return { override: false };
  const trimmed = prompt.trim();
  if (trimmed.startsWith('/')) {
    return { override: true, reason: 'user_explicit' };
  }
  if (knownNames && knownNames.size) {
    for (const name of knownNames) {
      if (!name) continue;
      const re = new RegExp(`(^|[^A-Za-z0-9/_-])${escapeRegex(name)}($|[^A-Za-z0-9/_-])`);
      if (re.test(prompt)) {
        return { override: true, reason: 'user_explicit', matched: name };
      }
    }
  }
  return { override: false };
}

function escapeRegex(s) {
  return String(s).replace(/[.*+?^${}()|[\]\\]/g, '\\$&');
}

// Build the known-names set from a mode-map (GRD-04 named-name half).
// Collects: each entry's /<mode> slash form (always), plus multi-token names
// (id, mode, recommended_skills/agents that contain a hyphen or underscore).
// Bare single-word ids/modes (e.g. "commit", "ship", "quick", "undo") are
// deliberately EXCLUDED so a common English verb appearing naturally in a
// routing prompt does not falsely trip user_explicit (Task 3 blocker Gap 3 —
// e.g. "commit my staged changes and open a PR" must route, not pass-through).
// The slash form /<mode> is always added so an explicit "/gsd-debug" still fires.
function isMultiToken(s) {
  return /[-_]/.test(String(s || ''));
}
export function buildKnownNames(modeMap) {
  const set = new Set();
  if (!modeMap || !Array.isArray(modeMap.entries)) return set;
  for (const e of modeMap.entries) {
    if (e.mode) {
      set.add(`/${e.mode}`); // slash form always — explicit "/gsd-debug" must fire
      if (isMultiToken(e.mode)) set.add(e.mode); // bare multi-token mode name
    }
    if (e.id && isMultiToken(e.id)) set.add(e.id); // drop bare single-word ids
    for (const s of (e.recommended_skills || [])) if (s && isMultiToken(s)) set.add(s);
    for (const a of (e.recommended_agents || [])) if (a && isMultiToken(a)) set.add(a);
  }
  return set;
}

// Re-entry dedupe (INJ-05). Returns true iff the exact router sentinel
// `<!-- router-inject -->` is a substring of the prompt. Scans ONLY for the
// exact sentinel — never for arbitrary HTML comments (would mis-detect).
// Called at the START of formatInjection in later plans; this plan ships it as
// a pure exported helper so Plan 02/03 can wire it in.
export function sentinelScan(prompt) {
  if (typeof prompt !== 'string') return false;
  return prompt.includes(SENTINEL);
}

// Manifest freshness verdict (D-19 / MAN-01 / MAN-02).
//   manifest_missing -> pass-through, no reminder
//   stale           -> pass-through + one-line HTML-comment reminder
//                       (no slash, so the model cannot auto-invoke it — D-01)
//   fresh           -> no reminder
// Accepts optional path args so tests can run against temp dirs without
// touching the real manifest on disk.
export function checkFreshness(manifestPath = MANIFEST, buildScriptPath = BUILD_SCRIPT) {
  try {
    if (!existsSync(manifestPath)) {
      return { status: 'manifest_missing' };
    }
    const manifestMtime = statSync(manifestPath).mtimeMs;
    const buildScriptMtime = existsSync(buildScriptPath) ? statSync(buildScriptPath).mtimeMs : 0;
    const now = Date.now();
    const ageIsOld = now - manifestMtime > STALE_MS;
    const builderNewer = buildScriptMtime > manifestMtime;
    if (ageIsOld || builderNewer) {
      return { status: 'stale', reminder: STALE_REMINDER };
    }
    return { status: 'fresh' };
  } catch {
    return { status: 'error' };
  }
}

export function checkCoverageFreshness(
  manifestPath = MANIFEST,
  reportPath = COVERAGE_REPORT,
) {
  try {
    if (!existsSync(reportPath)) {
      return { status: 'missing', reminder: COVERAGE_REMINDER };
    }
    if (statSync(reportPath).mtimeMs < statSync(manifestPath).mtimeMs) {
      return { status: 'stale', reminder: COVERAGE_REMINDER };
    }
    return { status: 'fresh' };
  } catch {
    return { status: 'error', reminder: COVERAGE_REMINDER };
  }
}

// --- stdin reader (caveman pattern: broken pipe -> exit 0, never throw) ---

function readStdin(onDone) {
  let input = '';
  process.stdin.setEncoding('utf8');
  process.stdin.on('data', (c) => { input += c; });
  process.stdin.on('error', () => process.exit(0)); // broken pipe -> pass-through
  process.stdin.on('end', () => onDone(input));
}

// --- Wave 2: scoring / decision pipeline (BM25 + cache + graphify) --------
// Plan 01-02: scoring/decision half. The route is computed but NOT yet emitted
// as additionalContext — Plan 03 adds formatInjection. main() returns
// pass-through (no additionalContext) until then. Tests exercise the exported
// pure functions directly.

// Tokenizer (RTE-02/D-04, §3 STOP set). Lowercase → split on non-alphanumerics
// → drop stop words + 1-char tokens.
const STOP = new Set([
  'the', 'a', 'an', 'and', 'or', 'to', 'of', 'in', 'for', 'on', 'with',
  'is', 'are', 'be', 'by', 'at', 'it', 'this', 'that', 'from', 'as',
  'your', 'you', 'i', 'via', 'using', 'use',
]);

export function tokenize(text) {
  return String(text || '')
    .toLowerCase()
    .split(/[^a-z0-9]+/)
    .filter((t) => t.length > 1 && !STOP.has(t));
}

// Load the manifest JSON; on any throw return null (caller passes through).
export function loadManifest(path = MANIFEST) {
  try {
    return JSON.parse(readFileSync(path, 'utf8'));
  } catch {
    return null;
  }
}

// Load mode-map JSON; on any throw return null.
export function loadModeMap(path = MODE_MAP) {
  try {
    return JSON.parse(readFileSync(path, 'utf8'));
  } catch {
    return null;
  }
}

// INVC-03: epoch-gated calibration read. Shape mirrors the best-effort
// try/catch-return-default stat pattern. NEVER throws, NEVER mutates.
//   - manifestFingerprint === calibration.manifest_fingerprint AND
//     calibration.thresholds is a plain object → { matched: true, thresholds }
//   - otherwise (mismatch | absent | corrupt/parse error) →
//     { matched: false, thresholds: null } so mode-map defaults win.
export function loadEpochCalibration(manifestFingerprint, { calibrationPath = CALIBRATION_PATH, modeMapVersion = null } = {}) {
  try {
    if (!calibrationPath || !existsSync(calibrationPath)) return { matched: false, thresholds: null };
    const parsed = JSON.parse(readFileSync(calibrationPath, 'utf8'));
    if (
      parsed
      && typeof parsed === 'object'
      && !Array.isArray(parsed)
      && parsed.manifest_fingerprint === manifestFingerprint
      && parsed.calibration_status !== 'rolled_back'
      && (modeMapVersion == null || String(parsed.mode_map_version) === String(modeMapVersion))
      && parsed.thresholds
      && typeof parsed.thresholds === 'object'
      && !Array.isArray(parsed.thresholds)
      && typeof parsed.thresholds.T_high === 'number'
      && typeof parsed.thresholds.T_low === 'number'
      && typeof parsed.thresholds.M === 'number'
      && validCalibrationThresholds(parsed.thresholds)
    ) {
      return { matched: true, thresholds: parsed.thresholds };
    }
    return { matched: false, thresholds: null };
  } catch {
    // corrupt/unreadable → fail-open: defaults win, never a hot-path throw.
    return { matched: false, thresholds: null };
  }
}

export function normalizeSignalPattern(raw, schemaVersion = 2) {
  if (typeof raw === 'string') {
    const value = raw.toLowerCase().replace(/\s+/g, ' ').trim();
    return value ? { kind: 'contains', value } : null;
  }
  if (Number(schemaVersion) < 3 || !raw || typeof raw !== 'object' || Array.isArray(raw)) return null;
  const value = typeof raw.value === 'string'
    ? raw.value.toLowerCase().replace(/\s+/g, ' ').trim()
    : '';
  if (raw.kind !== 'contains' || !value) return null;
  const collisionGroup = typeof raw.collision_group === 'string' ? raw.collision_group.trim() : '';
  return {
    kind: 'contains',
    value,
    ...(collisionGroup ? { collision_group: collisionGroup } : {}),
  };
}

const INVENTORY_COVERAGE_KEYS = [
  'skills',
  'plugin_skills',
  'agents_store_skills',
  'agents',
  'commands',
  'hooks',
  'mcp_servers',
  'unwired_mcp_refs',
];
const ROUTE_INVOKE_KINDS = new Set(['slash', 'skill', 'agent', 'warn']);

function stripLeadingSlash(value) {
  return String(value || '').replace(/^\/+/, '');
}

function inventoryNames(value) {
  if (Array.isArray(value)) return value.map((entry) => String(entry?.name || entry?.id || '')).filter(Boolean);
  if (value && typeof value === 'object') return Object.keys(value);
  return [];
}

function inventoryEntry(manifest, category, name) {
  const source = manifest?.[category];
  if (Array.isArray(source)) {
    return source.find((entry) => String(entry?.name || entry?.id || '') === name) || { id: name, name };
  }
  return { id: name, name };
}

function hasMissingMcp(entry) {
  return Array.isArray(entry?.requires_mcp_not_in_manifest) && entry.requires_mcp_not_in_manifest.length > 0;
}

function isProjectScoped(entry) {
  return String(entry?.scope || '') === 'project';
}

function projectCwdIncludes(cwd, projectRoot) {
  const candidate = String(cwd || '').replaceAll('\\', '/').replace(/\/+$/, '');
  const root = String(projectRoot || '').replaceAll('\\', '/').replace(/\/+$/, '');
  return Boolean(root) && (candidate === root || candidate.startsWith(`${root}/`));
}

function categoryCounts() {
  return {
    discovered: 0,
    routeable: 0,
    unmapped: 0,
    blocked_missing_mcp: 0,
    diagnostic_only: 0,
    dependency_only: 0,
    project_scoped: 0,
    excluded: 0,
  };
}

export function mappedTargets(modeMap) {
  const targets = new Set();
  for (const entry of modeMap?.entries || []) {
    for (const value of [entry?.id, entry?.mode]) {
      const target = stripLeadingSlash(value);
      if (target) targets.add(target);
    }
    for (const value of entry?.recommended_skills || []) {
      const target = stripLeadingSlash(value);
      if (target) targets.add(target);
    }
    for (const value of entry?.recommended_agents || []) {
      const target = stripLeadingSlash(value);
      if (target) targets.add(target);
    }
  }
  return targets;
}

function isMapped(entry, mapped) {
  return mapped.has(stripLeadingSlash(entry?.name)) || mapped.has(stripLeadingSlash(entry?.id));
}

export function classifyInventoryEntry(category, entry, mapped = new Set()) {
  if (category === 'hooks') return 'diagnostic_only';
  if (category === 'mcp_servers' || category === 'unwired_mcp_refs') return 'dependency_only';
  if (category === 'project_scoped_skills') return 'project_scoped';
  if (category === 'agents' && hasMissingMcp(entry)) return 'blocked_missing_mcp';
  if (category === 'agents_store_skills') {
    const scope = String(entry?.scope || '');
    if (scope && scope !== 'global') return 'excluded';
  }
  if (isProjectScoped(entry)) return 'project_scoped';
  if (['skills', 'plugin_skills', 'agents_store_skills', 'agents', 'commands'].includes(category)) {
    return isMapped(entry, mapped) ? 'routeable' : 'unmapped';
  }
  return 'excluded';
}

export function auditInventoryCoverage(manifest, modeMap) {
  const mapped = mappedTargets(modeMap);
  const counts = {};
  const entries = [];
  const highValueUnmapped = [];
  const blockedMissingMcp = [];
  const recommendationCandidates = [];

  for (const category of INVENTORY_COVERAGE_KEYS) {
    counts[category] = categoryCounts();
    for (const name of inventoryNames(manifest?.[category])) {
      const source = inventoryEntry(manifest, category, name);
      const classification = classifyInventoryEntry(category, source, mapped);
      counts[category].discovered += 1;
      counts[category][classification] = (counts[category][classification] || 0) + 1;
      const item = { category, name, classification };
      entries.push(item);
      if (classification === 'unmapped') {
        highValueUnmapped.push(item);
        recommendationCandidates.push(item);
      } else if (classification === 'blocked_missing_mcp') {
        blockedMissingMcp.push({
          ...item,
          missing_mcp: Array.isArray(source.requires_mcp_not_in_manifest) ? source.requires_mcp_not_in_manifest : [],
        });
      }
    }
  }

  return {
    mapped,
    counts,
    entries,
    highValueUnmapped,
    high_value_unmapped: highValueUnmapped,
    blockedMissingMcp,
    blocked_missing_mcp: blockedMissingMcp,
    recommendationCandidates,
    recommendation_candidates: recommendationCandidates,
  };
}

function namesFromEntries(entries, predicate = () => true) {
  return new Set((entries || [])
    .filter(predicate)
    .map((entry) => stripLeadingSlash(typeof entry === 'string' ? entry : (entry?.name || entry?.id)))
    .filter(Boolean));
}

export function buildTargetIndexes(manifest) {
  const safeAgent = (entry) => !hasMissingMcp(entry);
  const blockedAgent = (entry) => hasMissingMcp(entry);
  const globalAgentsStore = (entry) => String(entry?.scope || '') === 'global';
  const runtimeSlice = (manifest?.runtime_commands || {})[RUNTIME];
  const commandEntries = Array.isArray(runtimeSlice) && runtimeSlice.length > 0
    ? runtimeSlice
    : manifest?.commands;
  const commands = namesFromEntries(commandEntries);
  const globalSkills = namesFromEntries(manifest?.skills);
  const pluginSkills = namesFromEntries(manifest?.plugin_skills);
  const globalAgentsStoreSkills = namesFromEntries(manifest?.agents_store_skills, globalAgentsStore);
  return {
    commands,
    skills: globalSkills,
    globalSkills,
    pluginSkills,
    globalAgentsStoreSkills,
    routeTargets: new Set([...commands, ...globalSkills, ...pluginSkills, ...globalAgentsStoreSkills]),
    safeAgents: namesFromEntries(manifest?.agents, safeAgent),
    blockedAgents: namesFromEntries(manifest?.agents, blockedAgent),
    runtime: RUNTIME,
  };
}

// ROUTE-04 generic native-capability fallback. A fixed, capability-agnostic constant so a
// fabricated command/framework name is impossible; references only native capabilities.
const GENERIC_NATIVE_FALLBACK = 'Run a native capability from your available toolset if one matches.';

// Resolve-first route decision (Phase 32). Builds a framework-neutral candidate
// set purely from `entry.mode` (weight 1.0) + `entry.resolve[]` (their weights),
// dedups by stripped name, filters to candidates PRESENT in the active runtime's
// command inventory, and returns the highest-weighted present candidate — or null
// when nothing resolves (silent / stale, never a dead injection). No framework
// prefix is ever hardcoded: the candidate set comes only from the entry. Pure and
// fail-open (any throw returns null) so it is safe on the warm hot path.
//
// Accepts either the raw manifest (`.commands` array) or a buildTargetIndexes()
// result (`.commands` Set) as the presence source.
export function resolveSlashRoute(entry, manifestOrIndexes, opts = {}) {
  try {
    if (!entry) return null;
    let commands;
    let routeTargets;
    if (manifestOrIndexes && manifestOrIndexes.commands instanceof Set) {
      commands = manifestOrIndexes.commands;
      routeTargets = manifestOrIndexes.routeTargets || commands;
    } else {
      // PARITY-03 runtime-conditional presence: prefer the ACTIVE runtime's
      // runtime-tagged command slice (runtime_commands[RUNTIME], phase 31/26
      // shape) so a capability present only under one runtime is invisible to
      // the other and never leaked into a foreign suggestion. Falls back to the
      // plain .commands array when no runtime slice exists (pre-runtime
      // manifest). RUNTIME is the module-level active-runtime enum clamp
      // (unset/ambiguous defaults to claude) — never a foreign capability set.
      const runtimeSlice = (manifestOrIndexes?.runtime_commands || {})[RUNTIME];
      const source = Array.isArray(runtimeSlice)
        ? runtimeSlice
        : (manifestOrIndexes?.commands || []);
      commands = new Set(source.map((c) => {
        if (typeof c === 'string') return stripLeadingSlash(c);
        return stripLeadingSlash(c?.name || c?.id);
      }).filter(Boolean));
      routeTargets = new Set([
        ...commands,
        ...namesFromEntries(manifestOrIndexes?.skills),
        ...namesFromEntries(manifestOrIndexes?.plugin_skills),
        ...namesFromEntries(manifestOrIndexes?.agents_store_skills),
      ]);
    }
    const candidates = new Map();
    const addCandidate = (name, weight) => {
      const stripped = name == null ? '' : stripLeadingSlash(String(name));
      if (!stripped) return;
      const prev = candidates.get(stripped);
      if (prev === undefined || weight > prev.weight) candidates.set(stripped, { name: stripped, weight });
    };
    addCandidate(entry.mode, 1.0);
    for (const candidate of (entry.resolve || [])) {
      const weight = typeof candidate?.weight === 'number' ? candidate.weight : 1.0;
      addCandidate(candidate?.name, weight);
    }
    // T-32-15 / ROUTE-05: resolve-list members ABSENT from the active runtime's
    // present inventory are quarantined (flagged), never injected. Only the
    // active runtime's candidates are ever in play (PARITY-03).
    const quarantined = [...candidates.values()]
      .filter((candidate) => !routeTargets.has(candidate.name))
      .map((candidate) => candidate.name);
    const present = [...candidates.values()]
      .filter((candidate) => routeTargets.has(candidate.name))
      // ROUTE-01 ranked-list contract: weight desc, then declared authoring
      // order. ES2019+ Array#sort is stable, and candidates comes from the
      // insertion-ordered mode + resolve list Map.
      .sort((a, b) => b.weight - a.weight);
    if (present.length === 0) {
      // ROUTE-04: a high-confidence intent with an EMPTY resolve set (no mode candidate
      // ROUTE-04: a high-confidence intent with an EMPTY resolve set (no mode candidate
      // and no resolve member present) emits at most ONE generic native-capability
      // fallback line. The line is the fixed GENERIC_NATIVE_FALLBACK constant — never
      // derived from the entry id or any resolve candidate, so a fabricated capability
      // name is impossible. Only fires on a confident tier; otherwise stays silent.
      if (opts?.tier === 'high') {
        return { suggested_slash: null, tier: 'high', weight: null, fallback_lines: [GENERIC_NATIVE_FALLBACK], quarantined, provenance: [{ runtime: RUNTIME }] };
      }
      return null; // non-high-confidence empty resolve is silent (never a dead injection)
    }
    const top = present[0];
    // ROUTE-05 tie-lint: a near-tie (any other present candidate within 0.05 of the
    // top) is never shipped at a confident tier — downgrade high -> med.
    const second = present[1];
    const nearTie = second !== undefined && Math.abs(top.weight - second.weight) <= 0.05;
    let tier = opts?.tier === 'high' && top.weight >= 0.8 ? 'high' : 'med';
    if (nearTie && tier === 'high') tier = 'med';
    // PARITY-04: provenance attributes the resolved suggestion to the ACTIVE runtime
    // alone, so cross-runtime attribution holds (only the active runtime's suggestion
    // is injected).
    return { suggested_slash: top.name, tier, weight: top.weight, quarantined, provenance: [{ runtime: RUNTIME }] };
  } catch {
    return null; // fail-open: never throw on the hot path
  }
}

function knownSkillTargets(indexes) {
  return new Set([
    ...indexes.globalSkills,
    ...indexes.pluginSkills,
    ...indexes.globalAgentsStoreSkills,
  ]);
}

function routeDiagnostic(entry, status, target, reason) {
  return {
    id: entry?.id || null,
    invoke_kind: entry?.invoke_kind || null,
    status,
    target: target || null,
    reason,
  };
}

export function validateRouteTargets(manifest, modeMap, indexes = buildTargetIndexes(manifest)) {
  const rows = [];
  const routeIds = new Set((modeMap?.entries || []).map((entry) => stripLeadingSlash(entry?.id)).filter(Boolean));
  const skills = knownSkillTargets(indexes);
  const routeTargets = indexes.routeTargets || new Set([...indexes.commands, ...skills]);
  const collisions = new Map();
  const schemaVersion = Number(modeMap?.schema_version || 2);

  for (const entry of modeMap?.entries || []) {
    const shapeErrors = [];
    if (!entry?.id) shapeErrors.push(['<entry>', 'missing id']);
    if (!entry?.invoke_kind || !ROUTE_INVOKE_KINDS.has(entry.invoke_kind)) shapeErrors.push([entry?.invoke_kind || '<invoke_kind>', 'invalid invoke_kind']);
    if (!Array.isArray(entry?.signal_patterns)) shapeErrors.push(['signal_patterns', 'must be an array']);
    if (!Array.isArray(entry?.recommended_skills)) shapeErrors.push(['recommended_skills', 'must be an array']);
    if (!Array.isArray(entry?.recommended_agents)) shapeErrors.push(['recommended_agents', 'must be an array']);
    for (const [target, reason] of shapeErrors) rows.push(routeDiagnostic(entry, 'invalid_shape', target, reason));
    if (shapeErrors.length) continue;

    if (entry.signal_patterns.length < 1 || (schemaVersion >= 3 && entry.signal_patterns.length > 6)) {
      rows.push(routeDiagnostic(entry, 'invalid_pattern_count', 'signal_patterns', 'must contain 1 through 6 patterns'));
    }
    entry.signal_patterns.forEach((raw, index) => {
      const pattern = normalizeSignalPattern(raw, schemaVersion);
      if (!pattern) {
        rows.push(routeDiagnostic(entry, 'invalid_pattern', `signal_patterns[${index}]`, 'pattern must normalize to a non-empty contains value'));
        return;
      }
      const key = `${pattern.kind}\0${pattern.value}`;
      if (!collisions.has(key)) collisions.set(key, []);
      collisions.get(key).push({
        entry,
        group: pattern.collision_group || '',
      });
    });

    if (entry.invoke_kind === 'slash') {
      const mode = stripLeadingSlash(entry.mode);
      const id = stripLeadingSlash(entry.id);
      const intentionalRouteAlias = mode && mode !== id && routeIds.has(mode);
      // Guard-hole closure (T-32-05): a slash route is intentional only when mode is
      // a present manifest command OR a resolve-list member resolves to one. The
      // blanket `mode === id && schema_version` pass is removed — schema_version
      // truthiness no longer makes any slash route intentional.
      const intentionalResolveRoute = mode && Boolean(resolveSlashRoute(entry, indexes));
      if (!mode || (!routeTargets.has(mode) && !intentionalRouteAlias && !intentionalResolveRoute)) {
        rows.push(routeDiagnostic(entry, 'stale_target', mode || '<mode>', 'slash mode must match a manifest command or intentional mode-map route id'));
      }
      // T-32-10 forward-orphan: when a slash route is otherwise resolvable (its mode is a
      // present command, or a resolve member resolves to one), resolve-list members that are
      // ABSENT from the active manifest's command inventory are flagged (quarantined), never
      // silently dropped. A fully-unresolvable route is reported once by its mode and does
      // not additionally flag each member, so it stays a single stale_target.
      const routeResolvable = Boolean(routeTargets.has(mode)) || Boolean(intentionalResolveRoute);
      if (routeResolvable) {
        for (const member of entry.resolve || []) {
          const name = stripLeadingSlash(member?.name);
          if (name && !routeTargets.has(name)) {
            rows.push(routeDiagnostic(entry, 'stale_target', name, 'resolve member is absent from the manifest command inventory'));
          }
        }
      }
    }

    if (entry.invoke_kind === 'agent' && entry.recommended_agents.length === 0) {
      rows.push(routeDiagnostic(entry, 'invalid_shape', '<recommended_agents>', 'invoke_kind agent requires at least one safe agent'));
    }

    if (entry.invoke_kind === 'warn') {
      const warning = String(entry.warning || '');
      if (!warning && (entry.recommended_skills.length > 0 || entry.recommended_agents.length > 0)) {
        rows.push(routeDiagnostic(entry, 'warning_only', '<warning>', 'warn route needs a warning string when target lists are non-empty'));
      }
      if (/Dispatch agent/i.test(warning)) {
        rows.push(routeDiagnostic(entry, 'warning_only', '<warning>', 'warn route must not imply Dispatch agent wording'));
      }
    }

    if (entry.invoke_kind !== 'warn') {
      for (const target of entry.recommended_skills) {
        const name = stripLeadingSlash(target);
        if (!skills.has(name)) rows.push(routeDiagnostic(entry, 'stale_target', name, 'recommended skill is not in global/plugin/global-agents-store skill inventory'));
      }
    }

    for (const target of entry.recommended_agents) {
      const name = stripLeadingSlash(target);
      if (indexes.blockedAgents.has(name)) {
        rows.push(routeDiagnostic(entry, 'blocked_dispatch_agent', name, entry.invoke_kind === 'warn'
          ? 'warn route must not carry missing-MCP agents as dispatch targets'
          : 'agent requires_mcp_not_in_manifest and cannot be a dispatch target'));
      } else if (entry.invoke_kind !== 'warn' && !indexes.safeAgents.has(name)) {
        rows.push(routeDiagnostic(entry, 'stale_target', name, 'agent is not a safe manifest agent'));
      }
    }

    if (!rows.some((row) => row.id === entry.id)) rows.push(routeDiagnostic(entry, 'ok', null, 'route targets resolve'));
  }

  for (const occurrences of schemaVersion >= 3 ? collisions.values() : []) {
    if (occurrences.length < 2) continue;
    const group = occurrences[0].group;
    if (group && occurrences.every((occurrence) => occurrence.group === group)) continue;
    for (const occurrence of occurrences) {
      rows.push(routeDiagnostic(occurrence.entry, 'pattern_collision', 'signal_patterns', 'duplicate patterns require one identical non-empty collision_group'));
    }
  }

  return rows;
}

// SAF-02 hot-path stale-target predicate. Factored from validateRouteTargets
// (lines 636-697) but evaluates a SINGLE cached route against the current
// manifest instead of iterating the whole mode-map. Reuses buildTargetIndexes,
// knownSkillTargets, stripLeadingSlash, and the same indexes.commands /
// indexes.safeAgents / indexes.blockedAgents sets — no second Set builder
// (Pitfall 3 guard). Returns true for null/warn/pass-through routes (nothing
// to verify) and true on any internal error (fail-open: never blocks a cache
// hit from being served; the caller falls through to recompute on false only).
// Do NOT call validateRouteTargets on the hot path — it builds diagnostic
// rows for every entry (prohibition).
export function routeTargetsExist(route, manifest, modeMap, indexes) {
  try {
    if (!route) return true; // nothing to verify (warn/pass-through/no route)
    const kind = route.invoke_kind;
    // Warn routes carry a warning string, not dispatch targets — nothing to verify.
    if (kind === 'warn') return true;
    // Pass-through routes (no invoke_kind or low tier with no injection) — nothing to verify.
    if (!kind || kind === '') return true;
    // Build indexes inside the try so a malformed manifest fails open (returns
    // true) instead of throwing out of the default-parameter evaluation.
    const idx = indexes || buildTargetIndexes(manifest);
    const skills = knownSkillTargets(idx);
    // Slash routes: the mode must resolve as a manifest command. This mirrors
    // validateRouteTargets, which checks entry.mode (not entry.id) against
    // indexes.routeTargets — entry.id is the mode-map identifier, not necessarily
    // a command name. A miss means the command was removed or renamed since the
    // cache entry was written.
    if (kind === 'slash') {
      const mode = stripLeadingSlash(route.mode || route.id || '');
      const id = stripLeadingSlash(route.id);
      const routeIds = new Set((modeMap?.entries || []).map((entry) => stripLeadingSlash(entry?.id)).filter(Boolean));
      const intentionalRouteAlias = mode && mode !== id && routeIds.has(mode);
      // Guard-hole closure (T-32-05) mirrored on the hot path: valid only when mode
      // is a present command OR a resolve-list member resolves to a present command.
      const intentionalResolveRoute = mode && Boolean(resolveSlashRoute(route, idx));
      const routeTargets = idx.routeTargets || new Set([...idx.commands, ...skills]);
      if (mode && !routeTargets.has(mode) && !intentionalRouteAlias && !intentionalResolveRoute) return false;
    }
    for (const target of (route.recommended_skills || [])) {
      const name = stripLeadingSlash(target);
      if (!skills.has(name)) return false;
    }
    for (const target of (route.recommended_agents || [])) {
      const name = stripLeadingSlash(target);
      if (!idx.safeAgents.has(name)) return false;
    }
    return true;
  } catch {
    return true; // fail-open: never block a cache hit on an internal error
  }
}

const UNMAPPED_RANK_BASIS = 'commands, global skills, plugin skills, safe agents, keyword priority, name';
const UNMAPPED_KEYWORD_RE = /\b(gsd|router|codebase|debug|test|review|docs?|graph|audit|fix|health|coverage)\b/i;

function sourceLabel(category) {
  if (category === 'commands') return 'command';
  if (category === 'skills') return 'global skill';
  if (category === 'plugin_skills') return 'plugin skill';
  if (category === 'agents') return 'safe agent';
  if (category === 'agents_store_skills') return 'global agents-store skill';
  return category || 'inventory';
}

function categoryRank(category) {
  if (category === 'commands') return 0;
  if (category === 'skills') return 1;
  if (category === 'plugin_skills') return 2;
  if (category === 'agents') return 3;
  if (category === 'agents_store_skills') return 4;
  return 9;
}

function keywordRank(name) {
  return UNMAPPED_KEYWORD_RE.test(String(name || '')) ? 0 : 1;
}

function enrichUnmappedItem(item, rank = 0) {
  const source = sourceLabel(item?.category);
  return {
    ...item,
    rank,
    source,
    reason: `${source} is present in the manifest but not covered by any mode-map target`,
    routeability: 'candidate',
    recommendation: `Add a high-signal mode-map entry or route pattern for ${item?.name}.`,
  };
}

function enrichBlockedItem(item) {
  const missing = Array.isArray(item?.missing_mcp) ? item.missing_mcp.join(', ') : '';
  return {
    ...item,
    source: sourceLabel(item?.category),
    reason: missing
      ? `agent requires missing MCP server(s): ${missing}`
      : 'agent requires missing MCP server(s)',
    routeability: 'blocked',
    recommendation: 'Wire missing MCP first, or keep coverage as warn-only diagnostic output.',
  };
}

function rankedUnmappedItems(items = []) {
  return [...items]
    .sort((a, b) => (
      categoryRank(a.category) - categoryRank(b.category)
      || keywordRank(a.name) - keywordRank(b.name)
      || String(a.name || '').localeCompare(String(b.name || ''))
    ))
    .map((item, index) => enrichUnmappedItem(item, index + 1));
}

function nextFixes({ audit = null, diagnostics = [] } = {}) {
  const fixes = [];
  const stale = diagnostics.filter((row) => row.status === 'stale_target' || row.status === 'invalid_shape');
  const blocked = audit?.blockedMissingMcp || [];
  const unmapped = audit?.highValueUnmapped || [];
  if (stale.length) fixes.push({ reason: `${stale.length} route target diagnostics need cleanup`, action: 'Update mode-map entries so ids, modes, skills, and agents resolve to manifest inventory.' });
  if (blocked.length) fixes.push({ reason: `${blocked.length} agents require missing MCP servers`, action: 'Wire missing MCP servers before exposing those agents as dispatch targets.' });
  if (unmapped.length) fixes.push({ reason: `${unmapped.length} useful inventory entries are unmapped`, action: 'Add high-signal mode-map routes for the highest-value unmapped skills, agents, or commands.' });
  if (!fixes.length) fixes.push({ reason: 'No route safety defects found', action: 'Review coverage periodically as inventory changes.' });
  return fixes;
}

export function listRoutes(manifest, modeMap) {
  const diagnostics = validateRouteTargets(manifest, modeMap);
  const byId = new Map();
  for (const row of diagnostics) {
    if (!byId.has(row.id)) byId.set(row.id, []);
    byId.get(row.id).push(row);
  }
  const routes = (modeMap?.entries || []).map((entry) => {
    const rows = byId.get(entry.id) || [];
    return {
      id: entry.id,
      mode: entry.mode || null,
      invoke_kind: entry.invoke_kind || null,
      examples: Array.isArray(entry.signal_patterns) ? entry.signal_patterns.slice(0, 3) : [],
      recommended_skills: Array.isArray(entry.recommended_skills) ? entry.recommended_skills : [],
      recommended_agents: Array.isArray(entry.recommended_agents) ? entry.recommended_agents : [],
      warning: entry.warning || null,
      args_hint: entry.args_hint || null,
      target_health: {
        status: rows.every((row) => row.status === 'ok') ? 'ok' : 'issues',
        diagnostics: rows,
      },
    };
  });
  return { status: 'ok', total: routes.length, routes, diagnostics, next_fixes: nextFixes({ diagnostics }) };
}

export function listUnmapped(manifest, modeMap) {
  const audit = auditInventoryCoverage(manifest, modeMap);
  const items = rankedUnmappedItems(audit.highValueUnmapped);
  return {
    status: 'ok',
    total: items.length,
    rank_basis: UNMAPPED_RANK_BASIS,
    items,
    blocked_missing_mcp: audit.blockedMissingMcp.map(enrichBlockedItem),
    next_fixes: nextFixes({ audit }),
  };
}

export function summarizeCoverage(manifest, modeMap) {
  const audit = auditInventoryCoverage(manifest, modeMap);
  const routeable_total = Object.values(audit.counts).reduce((sum, counts) => sum + (counts.routeable || 0), 0);
  const discovered_total = Object.values(audit.counts).reduce((sum, counts) => sum + (counts.discovered || 0), 0);
  const unmapped_total = Object.values(audit.counts).reduce((sum, counts) => sum + (counts.unmapped || 0), 0);
  return {
    status: 'ok',
    totals: {
      discovered: discovered_total,
      routeable: routeable_total,
      unmapped: unmapped_total,
      blocked_missing_mcp: audit.blockedMissingMcp.length,
      diagnostic_only: Object.values(audit.counts).reduce((sum, counts) => sum + (counts.diagnostic_only || 0), 0),
      dependency_only: Object.values(audit.counts).reduce((sum, counts) => sum + (counts.dependency_only || 0), 0),
      project_scoped: Object.values(audit.counts).reduce((sum, counts) => sum + (counts.project_scoped || 0), 0),
      excluded: Object.values(audit.counts).reduce((sum, counts) => sum + (counts.excluded || 0), 0),
    },
    mapped_total: audit.mapped.size,
    categories: audit.counts,
    entries: audit.entries,
    high_value_unmapped: rankedUnmappedItems(audit.highValueUnmapped).slice(0, 25),
    blocked_missing_mcp: audit.blockedMissingMcp.map(enrichBlockedItem),
    next_fixes: nextFixes({ audit }),
  };
}

function fileHealth(path) {
  try {
    if (!path || !existsSync(path)) return { exists: false, status: 'missing' };
    const st = statSync(path);
    return {
      exists: true,
      status: 'ok',
      size: st.size,
      mtime: new Date(st.mtimeMs).toISOString(),
      mode: (st.mode & 0o777).toString(8),
    };
  } catch {
    return { exists: false, status: 'error' };
  }
}

function parseJsonFileStatus(path) {
  const health = fileHealth(path);
  if (!health.exists || health.status !== 'ok') return { ...health, parse_status: health.status };
  try {
    const parsed = JSON.parse(readFileSync(path, 'utf8'));
    return { ...health, parse_status: 'ok', schema_version: parsed?.schema_version ?? null };
  } catch {
    return { ...health, parse_status: 'error' };
  }
}

function manifestHealth(path) {
  const health = parseJsonFileStatus(path);
  const freshness = checkFreshness(path, BUILD_SCRIPT);
  let age_hours = null;
  if (health.exists && health.mtime) {
    age_hours = Math.max(0, Math.round(((Date.now() - Date.parse(health.mtime)) / 36e5) * 10) / 10);
  }
  return { ...health, freshness, age_hours };
}

function telemetryHealth(path) {
  const health = fileHealth(path);
  const privacy = {
    raw_prompt_text: false,
    raw_lines: false,
    note: 'telemetry health reports parse status and decision metadata only',
  };
  if (!health.exists || health.status !== 'ok') {
    return { ...health, parse_status: health.status, latest: explainLastStatus(health.status), privacy };
  }
  try {
    const lines = readFileSync(path, 'utf8').split(/\r?\n/).filter(Boolean);
    if (!lines.length) return { ...health, parse_status: 'empty', latest: explainLastStatus('empty'), privacy };
    let latest = null;
    for (let i = lines.length - 1; i >= 0; i--) {
      try {
        latest = JSON.parse(lines[i]);
        break;
      } catch {}
    }
    if (!latest) return { ...health, parse_status: 'empty', latest: explainLastStatus('empty'), privacy };
    const latestStatus = explainLastDecision({ telemetryPath: path });
    return {
      ...health,
      parse_status: 'ok',
      latest: {
        status: latestStatus.status,
        prompt_signature: latestStatus.prompt_signature,
        selected_route: latestStatus.selected_route ? {
          id: latestStatus.selected_route.id || null,
          mode: latestStatus.selected_route.mode || null,
          invoke_kind: latestStatus.selected_route.invoke_kind || null,
        } : null,
        confidence_tier: latestStatus.confidence_tier,
        graph_status: latestStatus.graph_status || null,
        privacy_note: latestStatus.privacy_note,
      },
      privacy,
    };
  } catch {
    return { ...health, parse_status: 'error', latest: explainLastStatus('error'), privacy };
  }
}

function routerStatus({ manifest, modeMap, routeDiagnostics = [], coverage = null, telemetry = null, cache = null, weights = null, evolution = null } = {}) {
  if (!manifest || !modeMap) return 'error';
  const badRoutes = routeDiagnostics.some((row) => row.status !== 'ok');
  const blocked = (coverage?.blocked_missing_mcp || []).length > 0;
  const unmapped = (coverage?.high_value_unmapped || []).length > 0;
  const staleManifest = coverage && false;
  const badStatusFiles = [telemetry, cache, weights, evolution?.state].some((item) => item && ['error'].includes(item.parse_status));
  if (badRoutes || blocked || unmapped || staleManifest || badStatusFiles) return 'warn';
  return 'ok';
}

function readJsonForVisibility(path) {
  const health = parseJsonFileStatus(path);
  if (health.parse_status !== 'ok') return { health, value: null };
  try {
    return { health, value: JSON.parse(readFileSync(path, 'utf8')) };
  } catch {
    return { health: { ...health, parse_status: 'error' }, value: null };
  }
}

function entryIdForWeightCandidate(candidate, modeMap = null) {
  if (!candidate) return null;
  if (typeof candidate === 'string') return candidate;
  if (candidate.entry && candidate.entry.id) return String(candidate.entry.id);
  if (candidate.id) return String(candidate.id);
  if (candidate.route_target && candidate.route_target.id) return String(candidate.route_target.id);
  if (candidate.selected_route && candidate.selected_route.id) return String(candidate.selected_route.id);
  const name = candidate.name || candidate.mode || null;
  const mm = name ? modeMapEntryForName(modeMap, name) : null;
  return mm && mm.id ? String(mm.id) : (name ? String(name) : null);
}

export function explainWeightApplication(candidate, context = {}) {
  const modeMap = context.modeMap || _modeMapForBlend || null;
  const entryId = entryIdForWeightCandidate(candidate, modeMap);
  const weights = context.weights || null;
  const weightsStatus = context.weights_status || null;
  const reasonCodes = [];
  const base = {
    entry_id: entryId,
    applied: false,
    effective_weight: null,
    weight_record_status: 'unknown',
    reason_codes: reasonCodes,
    outcomes: null,
  };
  if (!entryId) {
    reasonCodes.push('not_weighted_candidate');
    return { ...base, weight_record_status: 'not_weighted_candidate' };
  }
  if (!weights || !weights.weights || typeof weights.weights !== 'object') {
    const code = weightsStatus && weightsStatus.parse_status === 'error' ? 'weights_malformed' : 'weights_missing';
    reasonCodes.push(code);
    return { ...base, weight_record_status: code };
  }
  const mmEntry = modeMap && Array.isArray(modeMap.entries)
    ? modeMap.entries.find((e) => e && String(e.id || '') === entryId)
    : null;
  if (mmEntry && mmEntry.invoke_kind === 'warn') {
    reasonCodes.push('warn_skipped');
    const record = weights.weights[entryId] || null;
    return {
      ...base,
      weight_record_status: 'warn_skipped',
      outcomes: record ? { g: Number(record.g || 0), b: Number(record.b || 0), u: Number(record.u || 0) } : null,
    };
  }
  const record = weights.weights[entryId];
  if (!record || typeof record !== 'object') {
    reasonCodes.push('entry_record_missing');
    return { ...base, weight_record_status: 'missing' };
  }
  const score = typeof record.score === 'number' ? record.score : 0;
  const g = Number(record.g || 0);
  const b = Number(record.b || 0);
  const u = Number(record.u || 0);
  if (score === 0) reasonCodes.push('score_zero');
  if (g === 0) reasonCodes.push('no_good_outcomes');
  if (g === 0 && (b + u) > 0) reasonCodes.push('bad_or_unknown_only');
  if (reasonCodes.length === 0) reasonCodes.push('weight_applied');
  return {
    ...base,
    applied: true,
    effective_weight: score,
    weight_record_status: 'ok',
    reason_codes: reasonCodes,
    outcomes: { g, b, u },
    updated_at: record.updated_at || null,
  };
}

function proposalBase(status, telemetryStatus, windowMinutes, nowIso, sourceCounts = {}) {
  return {
    status,
    advisory: true,
    applied: false,
    generated_at: nowIso,
    window_minutes: windowMinutes,
    proposal_counts: { add: 0, edit: 0, prune: 0, total: 0 },
    counts: { add: 0, edit: 0, prune: 0, total: 0 },
    proposals: [],
    suggestions: [],
    source_counts: { telemetry_records: 0, correlated_outcomes: 0, mode_map_entries: 0, ...sourceCounts },
    telemetry_status: telemetryStatus,
    privacy: {
      raw_prompt_text: false,
      raw_lines: false,
      raw_telemetry_lines: false,
      note: 'proposals are telemetry-metadata-derived; raw prompts, raw lines, and downstream text are omitted',
    },
  };
}

function readTelemetryMetadata(path) {
  if (!path || !existsSync(path)) return { status: 'missing', records: [], malformed: 0 };
  let text = '';
  try { text = readFileSync(path, 'utf8'); }
  catch { return { status: 'error', records: [], malformed: 0 }; }
  const lines = text.split(/\r?\n/).filter(Boolean);
  if (!lines.length) return { status: 'empty', records: [], malformed: 0 };
  const records = [];
  let malformed = 0;
  for (const line of lines) {
    try {
      const row = JSON.parse(line);
      if (!row || typeof row !== 'object') { malformed++; continue; }
      records.push({
        ts: typeof row.ts === 'number' ? row.ts : Date.parse(row.ts) || 0,
        prompt_signature: row.prompt_signature || null,
        cwd: row.cwd || null,
        suggested_mode: row.suggested_mode || row.selected_route?.id || null,
        confidence_tier: row.confidence_tier || null,
        selected_route: row.selected_route && typeof row.selected_route === 'object' ? {
          id: row.selected_route.id || null,
          mode: row.selected_route.mode || null,
          invoke_kind: row.selected_route.invoke_kind || null,
        } : null,
        outcome: row.outcome || null,
      });
    } catch { malformed++; }
  }
  if (!records.length) return { status: malformed ? 'empty' : 'empty', records: [], malformed };
  return { status: malformed ? 'error' : 'ok', records, malformed };
}

function proposalType(raw) {
  return raw && (raw.kind || raw.type) ? String(raw.kind || raw.type) : 'unknown';
}

function proposalCounts(proposals) {
  const counts = { add: 0, edit: 0, prune: 0, total: proposals.length };
  for (const p of proposals) {
    const type = proposalType(p);
    if (type in counts) counts[type]++;
  }
  return counts;
}

function confidenceForProposal(raw, counts) {
  const type = proposalType(raw);
  if (type === 'edit' && counts && typeof counts.b === 'number') return Math.min(1, counts.b / Math.max(1, counts.g + counts.b + counts.u));
  if (type === 'add' && counts && typeof counts.u === 'number') return Math.min(1, counts.u / Math.max(1, counts.g + counts.b + counts.u));
  if (type === 'prune') return 0.5;
  return 0.6;
}

function sanitizePatterns(patterns) {
  if (!Array.isArray(patterns)) return [];
  return patterns
    .map((p) => normalizeSignalPattern(p, 3))
    .filter(Boolean)
    .map((p) => redact(p.value))
    .map((p) => p.slice(0, 80))
    .slice(0, 5);
}

function sanitizeProposal(raw, perEntry) {
  const type = proposalType(raw);
  const entryId = raw?.id || raw?.entry?.id || raw?.entry_id || null;
  const mode = raw?.mode || raw?.entry?.mode || entryId || null;
  const counts = entryId && perEntry instanceof Map ? (perEntry.get(String(entryId)) || { g: 0, b: 0, u: 0 }) : { g: 0, b: 0, u: 0 };
  const reason_codes = [];
  if (type === 'add') reason_codes.push('unknown_cluster');
  else if (type === 'edit') reason_codes.push('bad_outcome_ratio');
  else if (type === 'prune') reason_codes.push('not_recently_selected');
  else reason_codes.push('proposal');
  const suggested_patterns = sanitizePatterns(raw?.signal_patterns || raw?.entry?.signal_patterns || []);
  const out = {
    type,
    kind: type,
    entry_id: entryId ? String(entryId) : null,
    mode: mode ? String(mode) : null,
    mode_id: mode ? String(mode) : null,
    reason_codes,
    confidence: confidenceForProposal(raw, counts),
    counts: { g: Number(counts.g || 0), b: Number(counts.b || 0), u: Number(counts.u || 0) },
    suggested_patterns,
    signal_patterns: suggested_patterns,
    privacy_note: 'Derived from telemetry metadata and bounded token summaries; raw prompts and downstream events omitted.',
  };
  return out;
}

export function buildTelemetryProposals(options = {}) {
  const paths = options.paths || {};
  const telemetryPath = options.telemetryPath || paths.telemetry || TELEMETRY;
  const modeMapPath = options.modeMapPath || paths.modeMap || MODE_MAP;
  const windowMinutes = Number(options.windowMinutes || 30);
  const now = options.now instanceof Date ? options.now : new Date(options.now || Date.now());
  const nowMs = now.getTime();
  const nowIso = Number.isFinite(nowMs) ? now.toISOString() : new Date().toISOString();
  let modeMap = options.modeMap || null;
  if (!modeMap) modeMap = loadModeMap(modeMapPath);
  if (!modeMap || !Array.isArray(modeMap.entries)) modeMap = { entries: [] };

  const telemetry = readTelemetryMetadata(telemetryPath);
  const base = proposalBase(telemetry.status, telemetry.status, windowMinutes, nowIso, {
    telemetry_records: telemetry.records.length,
    mode_map_entries: Array.isArray(modeMap.entries) ? modeMap.entries.length : 0,
    malformed_lines: telemetry.malformed || 0,
  });
  if (telemetry.status !== 'ok' && telemetry.status !== 'error') return base;
  if (!telemetry.records.length) return base;

  try {
    const outcomes = correlateOutcomes(telemetry.records, { windowMinutes });
    const perEntry = aggregatePerEntry(outcomes, modeMap);
    const rawProposals = [
      ...proposeAdditions(outcomes, modeMap),
      ...proposeEdits(perEntry, modeMap, outcomes),
      ...proposePrunes(outcomes, modeMap, Number.isFinite(nowMs) ? nowMs : Date.now()),
    ];
    const proposals = rawProposals.map((p) => sanitizeProposal(p, perEntry));
    const counts = proposalCounts(proposals);
    return {
      ...base,
      status: telemetry.status === 'error' ? 'error' : 'ok',
      proposal_counts: counts,
      counts,
      proposals,
      suggestions: proposals,
      source_counts: {
        ...base.source_counts,
        correlated_outcomes: outcomes.length,
        proposal_primitives: rawProposals.length,
      },
    };
  } catch {
    return { ...base, status: 'error', telemetry_status: telemetry.status };
  }
}

export function summarizeEvolutionVisibility(options = {}) {
  const paths = options.paths || {};
  const modeMap = options.modeMap || loadModeMap(options.modeMapPath || paths.modeMap || MODE_MAP) || { entries: [] };
  const weightsPath = options.weightsPath || paths.weights || WEIGHTS;
  const statePath = options.evolutionStatePath || paths.evolutionState || EVOLUTION_STATE;
  const triggerPath = options.triggerPath || paths.evolveTrigger || paths.trigger || TRIGGER;
  const telemetryPath = options.telemetryPath || paths.telemetry || TELEMETRY;
  const weightsRead = options.weights
    ? { health: { exists: true, status: 'ok', parse_status: 'ok', schema_version: options.weights.schema_version ?? null }, value: options.weights }
    : readJsonForVisibility(weightsPath);
  const stateRead = options.evolutionState
    ? { health: { exists: true, status: 'ok', parse_status: 'ok', schema_version: options.evolutionState.schema_version ?? null }, value: options.evolutionState }
    : readJsonForVisibility(statePath);
  const telemetry = telemetryHealth(telemetryPath);
  const trigger = fileHealth(triggerPath);
  const candidates = Array.isArray(options.candidates) && options.candidates.length
    ? options.candidates
    : (Array.isArray(modeMap.entries) ? modeMap.entries.map((entry) => ({ id: entry.id })) : []);
  const selectedEntryId = options.selectedEntryId || options.selected_entry_id || null;
  const ids = new Set();
  if (selectedEntryId) ids.add(String(selectedEntryId));
  for (const c of candidates) {
    const id = entryIdForWeightCandidate(c, modeMap);
    if (id) ids.add(id);
  }
  const weightReasons = {};
  for (const id of ids) {
    weightReasons[id] = explainWeightApplication(id, {
      modeMap,
      weights: weightsRead.value,
      weights_status: weightsRead.health,
    });
  }
  const state = stateRead.value || {};
  return {
    status: weightsRead.health.parse_status === 'error' || stateRead.health.parse_status === 'error' ? 'warn' : 'ok',
    selected_entry_id: selectedEntryId ? String(selectedEntryId) : null,
    weights: weightsRead.health,
    weights_status: weightsRead.health,
    state: stateRead.health,
    state_status: stateRead.health,
    telemetry,
    trigger,
    last_run: {
      status: stateRead.health.parse_status,
      at: state.last_run || state.last_run_at || state.updated_at || null,
    },
    right_pick_rate: typeof state.right_pick_rate === 'number' ? state.right_pick_rate : null,
    proposal_counts: state.proposal_counts || null,
    weight_reasons: weightReasons,
    privacy: {
      raw_prompt_text: false,
      raw_lines: false,
      raw_telemetry_lines: false,
      note: 'evolution visibility reports statuses, route IDs, counts, and reason codes only',
    },
  };
}

export function diagnoseRouterState(options = {}) {
  const manifest = options.manifest || loadManifest(options.manifestPath || MANIFEST);
  const modeMap = options.modeMap || loadModeMap(options.modeMapPath || MODE_MAP);
  const paths = options.paths || {};
  const manifestPath = options.manifestPath || paths.manifest || MANIFEST;
  const modeMapPath = options.modeMapPath || paths.modeMap || MODE_MAP;
  const coverage = summarizeCoverage(manifest || {}, modeMap || {});
  const routes = listRoutes(manifest || {}, modeMap || {});
  const stale = routes.diagnostics.filter((row) => row.status !== 'ok');
  const telemetry = telemetryHealth(paths.telemetry || TELEMETRY);
  const cache = parseJsonFileStatus(paths.cache || CACHE);
  const weights = parseJsonFileStatus(paths.weights || WEIGHTS);
  const evolution = {
    state: parseJsonFileStatus(paths.evolutionState || EVOLUTION_STATE),
    trigger: fileHealth(paths.evolveTrigger || TRIGGER),
  };
  const evolution_visibility = summarizeEvolutionVisibility({
    modeMap,
    modeMapPath,
    paths: {
      weights: paths.weights || WEIGHTS,
      evolutionState: paths.evolutionState || EVOLUTION_STATE,
      evolveTrigger: paths.evolveTrigger || TRIGGER,
      telemetry: paths.telemetry || TELEMETRY,
    },
  });
  const status = routerStatus({ manifest, modeMap, routeDiagnostics: routes.diagnostics, coverage, telemetry, cache, weights, evolution });
  return {
    status,
    privacy: { raw_prompt_text: false, note: 'health diagnostics do not include raw prompt text' },
    manifest: { readable: !!manifest, ...manifestHealth(manifestPath) },
    mode_map: { readable: !!modeMap, entries: Array.isArray(modeMap?.entries) ? modeMap.entries.length : 0, ...parseJsonFileStatus(modeMapPath) },
    coverage,
    unmapped: { total: coverage.high_value_unmapped.length, items: coverage.high_value_unmapped.slice(0, 25) },
    missing_mcp: coverage.blocked_missing_mcp.flatMap((entry) => entry.missing_mcp || []),
    blocked_agents: coverage.blocked_missing_mcp,
    stale_targets: stale,
    hook: fileHealth(paths.hook || fileURLToPath(import.meta.url)),
    cache,
    telemetry,
    weights,
    evolution,
    evolution_visibility,
    next_fixes: nextFixes({ audit: auditInventoryCoverage(manifest || {}, modeMap || {}), diagnostics: stale }),
  };
}

// Phase 3 / EVO-01: weighted BM25 (D-08/D-09/D-11). Fail-open: returns null on any error.
export function loadWeights(path = WEIGHTS) {
  try {
    if (!existsSync(path)) return null;
    const parsed = JSON.parse(readFileSync(path, 'utf8'));
    if (!parsed || typeof parsed !== 'object') return null;
    // Accept both v1 (empty weights, no blend) and v2 (full schema). Refuse v3+ (forward-incompatible).
    if (parsed.schema_version && parsed.schema_version > 2) return null;
    if (!parsed.weights || typeof parsed.weights !== 'object') {
      parsed.weights = {};
    }
    return parsed;
  } catch {
    return null;
  }
}

// LOCKED 3-ARG SIGNATURE (RESEARCH §3 / D-09): `applyWeightBlend(normed, weights, blend)`.
// The modeMap is resolved inside the function via a module-level reference
// (MODE_MAP) so the per-prompt hot path does not need to pass it explicitly.
// (BLOCKER 3 fix: 4-arg signature was an over-eager refinement; the 3-arg
// signature is the locked decision in 03-RESEARCH.md §3.)
let _modeMapForBlend = null; // module-level; updated once per hook invocation
export function setModeMapForBlend(modeMap) { _modeMapForBlend = modeMap; }

export function applyWeightBlend(normed, weights, blend = 0.15) {
  if (!Array.isArray(normed) || !weights || !weights.weights) return normed;
  const weightsMap = weights.weights;
  const mmById = new Map();
  if (_modeMapForBlend && Array.isArray(_modeMapForBlend.entries)) {
    for (const e of _modeMapForBlend.entries) {
      if (e && e.id) mmById.set(e.id, e);
    }
  }
  return normed.map(n => {
    const entryId = n.entry && n.entry.id;
    const w = entryId && weightsMap[entryId];
    if (!w) return { ...n };
    const mmEntry = mmById.get(entryId);
    if (mmEntry && mmEntry.invoke_kind === 'warn') return { ...n };  // D-12: no weights for warn
    const newNorm = (1 - blend) * (n.norm || 0) + blend * (typeof w.score === 'number' ? w.score : 0);
    return { ...n, norm: newNorm, weight_applied: w.score };
  });
}

// Build the matchable corpus (RTE-01/D-05/§3). Corpus = skills (scope!=="project")
// + plugin_skills (no scope field) + agents_store_skills (scope!=="project" AND
// scope!=="agents-store (not globally symlinked)") + agents + commands. Hooks
// EXCLUDED (no description). Each corpus entry carries the token frequency Map,
// document length, and original manifest entry. Name tokens are weighted 3×
// (concatenated 3 times into the document text before tokenizing) so name hits
// dominate — cheap field-boost without BM25F. When `summary` is absent (commands,
// plugin_skills), fall back to name+description.
export function buildCorpus(manifest, modeMap = null, cwd = process.cwd()) {
  if (!manifest || typeof manifest !== 'object') return [];
  // Pre-index mode-map entries by the manifest entry names they map to, so each
  // manifest entry's associated mode-map signal_patterns can be appended to its
  // BM25 document text. Association: mode-map entry whose id, mode, or
  // recommended_skills/agents contains the manifest entry's name (case-insensitive).
  // When modeMap is null/absent (e.g. unit tests calling buildCorpus(manifest)),
  // no signal_patterns are appended → identical v1 behavior (159 tests stay green).
  const mmByName = new Map();
  if (modeMap && Array.isArray(modeMap.entries)) {
    const schemaVersion = Number(modeMap.schema_version || 2);
    for (const me of modeMap.entries) {
      const candidates = new Set();
      if (me.id) candidates.add(String(me.id).toLowerCase());
      if (me.mode) candidates.add(String(me.mode).toLowerCase());
      for (const s of (me.recommended_skills || [])) if (s) candidates.add(String(s).toLowerCase());
      for (const a of (me.recommended_agents || [])) if (a) candidates.add(String(a).toLowerCase());
      const sp = Array.isArray(me.signal_patterns)
        ? me.signal_patterns.map((raw) => normalizeSignalPattern(raw, schemaVersion)?.value).filter(Boolean)
        : [];
      for (const c of candidates) {
        if (!mmByName.has(c)) mmByName.set(c, []);
        mmByName.get(c).push(...sp);
      }
    }
  }
  const out = [];
  const push = (e) => {
    if (!e || !e.name) return;
    const name = String(e.name || '');
    const desc = String(e.description || '');
    const summary = e.summary ? String(e.summary) : `${name} ${desc}`;
    // signal_patterns from the associated mode-map entry (if any) — appended so
    // signal tokens become part of the BM25 doc without changing name/desc/summary.
    const sigs = mmByName.get(name.toLowerCase()) || [];
    const sigText = sigs.length ? ' ' + sigs.join(' ') : '';
    // name weighted 3× → concatenate name three times before tokenizing the rest
    const docText = `${name} ${name} ${name} ${desc} ${summary}${sigText}`;
    const toks = tokenize(docText);
    const tf = new Map();
    for (const t of toks) tf.set(t, (tf.get(t) || 0) + 1);
    out.push({ entry: e, name, tokens: tf, dl: toks.length });
  };
  const skills = Array.isArray(manifest.skills) ? manifest.skills : [];
  for (const e of skills) {
    if (e && e.scope === 'project') continue; // GRD-02
    push(e);
  }
  const pluginSkills = Array.isArray(manifest.plugin_skills) ? manifest.plugin_skills : [];
  for (const e of pluginSkills) push(e); // no scope field; summary absent → fallback
  const agentsStore = Array.isArray(manifest.agents_store_skills) ? manifest.agents_store_skills : [];
  for (const e of agentsStore) {
    if (!e) continue;
    if (e.scope === 'project') continue; // GRD-02
    if (e.scope === 'agents-store (not globally symlinked)') continue; // conservative (§3)
    push(e);
  }
  const projectSkills = Array.isArray(manifest.project_scoped_skills) ? manifest.project_scoped_skills : [];
  for (const e of projectSkills) {
    if (e && projectCwdIncludes(cwd, e.project)) push(e);
  }
  const agents = Array.isArray(manifest.agents) ? manifest.agents : [];
  // GRD-01: hard-filter agents whose requires_mcp_not_in_manifest is non-empty
  // OUT of the auto-dispatch pool BEFORE scoring. Such agents are never
  // auto-dispatched; applyGuards separately checks whether one would have been
  // the top candidate and demotes the route to warn if so.
  for (const e of agents) {
    if (e && Array.isArray(e.requires_mcp_not_in_manifest) && e.requires_mcp_not_in_manifest.length > 0) {
      continue; // MCP-missing — excluded from auto-dispatch pool
    }
    push(e);
  }
  const commands = Array.isArray(manifest.commands) ? manifest.commands : [];
  for (const e of commands) push(e); // summary absent → name+description fallback
  // Direct warn entries deliberately have no dispatch target, so they cannot be
  // associated to a manifest skill/agent by recommended_* fields. Add them as
  // mode-map-owned corpus entries so missing-MCP warnings can route directly.
  if (modeMap && Array.isArray(modeMap.entries)) {
    for (const e of modeMap.entries) {
      if (!e || e.invoke_kind !== 'warn' || !e.id) continue;
      const name = String(e.id || '');
      const desc = Array.isArray(e.signal_patterns)
        ? e.signal_patterns.map((raw) => normalizeSignalPattern(raw, modeMap.schema_version)?.value).filter(Boolean).join(' ')
        : '';
      const warning = typeof e.warning === 'string' ? e.warning : '';
      const toks = tokenize(`${name} ${name} ${name} ${desc} ${warning}`);
      const tf = new Map();
      for (const t of toks) tf.set(t, (tf.get(t) || 0) + 1);
      out.push({ entry: e, name, tokens: tf, dl: toks.length });
    }
  }
  // hooks[] deliberately EXCLUDED — no description field, event-bound (§3).
  return out;
}

// Okapi BM25 score (k1=1.5, b=0.75, §3). Returns array of {entry, name, score}
// sorted descending by score. df[t] = number of corpus entries containing t.
// IDF(t) = ln(1 + (N - df + 0.5)/(df + 0.5)). Per-entry score =
// Σ_{t∈Q} IDF(t) · (tf·(k1+1)) / (tf + k1·(1 - b + b·dl/avgdl)).
export function bm25Score(queryTokens, corpus, k1 = 1.5, b = 0.75) {
  const q = Array.isArray(queryTokens) ? queryTokens : [];
  if (!Array.isArray(corpus) || corpus.length === 0 || q.length === 0) return [];
  const N = corpus.length;
  // df map
  const df = new Map();
  for (const c of corpus) {
    for (const t of c.tokens.keys()) df.set(t, (df.get(t) || 0) + 1);
  }
  const avgdl = corpus.reduce((s, c) => s + c.dl, 0) / (N || 1);
  const scored = [];
  for (const c of corpus) {
    let score = 0;
    for (const t of q) {
      const tf = c.tokens.get(t);
      if (!tf) continue;
      const dft = df.get(t) || 0;
      const idf = Math.log(1 + (N - dft + 0.5) / (dft + 0.5));
      const denom = tf + k1 * (1 - b + (b * c.dl) / (avgdl || 1));
      score += idf * ((tf * (k1 + 1)) / (denom || 1));
    }
    if (score > 0) scored.push({ entry: c.entry, name: c.name, score });
  }
  scored.sort((a, b) => b.score - a.score);
  return scored;
}

// Per-query normalization (RTE-02). Divides by max → top = 1.0. Returns array
// of {entry, name, score, norm}. Runner-up margin = 1 - norm(runner_up).
export function normalize(scored) {
  if (!Array.isArray(scored) || scored.length === 0) return [];
  const max = scored[0].score; // scored is sorted descending
  const out = scored.map((s) => ({
    entry: s.entry,
    name: s.name,
    score: s.score,
    norm: max > 0 ? s.score / max : 0,
  }));
  return out;
}

// Confidence tier (RTE-05/D-09). High = top ≥ T_high AND margin ≥ M.
// Low = top < T_low OR top-2 within tie margin (margin < M).
// Medium = everything else (T_low ≤ top < T_high with decisive margin, or
// top ≥ T_high but margin < M = decisive-but-moderate).
export function confidenceTier(topScore, runnerUpScore, thresholds, hasCanonicalMatch = false) {
  const T = thresholds || { T_high: 0.6, T_low: 0.3, M: 0.2 };
  const top = Number(topScore) || 0;
  const runner = Number(runnerUpScore) || 0;
  const margin = top - runner;
  if (top < T.T_low) return 'low';
  if (margin < T.M) {
    // Tie — but if the top candidate is a known canonical mode-map entry, the
    // user clearly meant SOMETHING in the canonical set. Promote to 'medium'
    // so the model receives the suggestion. Preserves fail-open (model can
    // ignore a medium suggestion; it just doesn't get suppressed to nothing).
    return hasCanonicalMatch ? 'medium' : 'low';
  }
  if (top >= T.T_high && margin >= T.M) return 'high';
  return 'medium';
}

// --- LRU intent-signature cache (RTE-06/07/§8) ----------------------------

const CACHE_MAX = 256;

function newCache() {
  return { schema_version: 1, entries: {}, order: [], size: 0 };
}

export function loadCache(path = CACHE) {
  try {
    if (!existsSync(path)) return newCache();
    const c = JSON.parse(readFileSync(path, 'utf8'));
    if (!c || typeof c !== 'object' || !c.entries) return newCache();
    if (!Array.isArray(c.order)) c.order = [];
    if (typeof c.size !== 'number') c.size = c.order.length;
    return c;
  } catch {
    return newCache();
  }
}

// Pure lookup: returns the cached route or null. Does not mutate.
export function cacheLookup(sig, cache) {
  if (!cache || !cache.entries || !cache.entries[sig]) return null;
  const e = cache.entries[sig];
  return e && e.route ? e.route : null;
}

// Cache key (RTE-07 / SAF-01 / INVC-02 / WR-01 / WR-02). sha256(normalizedPrompt
// + "|" + intentKeywords.join(" ") + "|" + manifestFingerprint [+ "|" + liveHash]).
// The fingerprint is the manifest content-address epoch
// (manifest.manifest_fingerprint), replacing the old live mtime fold: a no-op
// rebuild keeps the key identical (cache not invalidated), while any semantic
// inventory change bumps the fingerprint -> key -> previously-cached route
// recomputed.
//
// WR-01/WR-02: mode-map.json, weights.json, and project graph.json changes do
// NOT trigger a manifest rebuild (the watcher ignores the router/ dir that holds
// mode-map/weights, and graph is project-side). To preserve invalidation for
// those edits WITHOUT re-introducing a raw absolute mtime into the semantic
// fingerprint, the key additionally folds LIVE CONTENT HASHES (not mtimes) of
// the loaded mode-map, weights, and graph when present. A content change
// invalidates; a no-op read returns an identical hash (deterministic); the
// manifest fingerprint still governs no-op-rebuild stability. Fail-open
// defaults: omitted/'' hashes leave the key byte-identical to the
// fingerprint-only form, and a missing fingerprint defaults to '0'.
// runtime (D-05 / PARITY-02): the active runtime (claude|codex) is folded into
// the hashed identity tuple ALWAYS (as a trailing slot), NOT into route
// metadata — so a Claude-served route and a Codex-served route can never hash to
// the same key, even when every live hash is '' (anti-pattern guard, RESEARCH
// Pitfall 3). The slot defaults to the module RUNTIME constant (detected once at
// module load, zero hot-path IO), so callers that do not pin a runtime — e.g.
// cache integration tests that pre-seed a cache with cacheKey() — derive the
// SAME key as the production call site, keeping pre-seeded entries reachable.
// An explicit runtime string (e.g. 'codex' vs 'claude') overrides the default and
// is the cross-runtime isolation knob.
export function cacheKey(normalizedPrompt, intentKeywords, manifestFingerprint = '0',
  modeMapHash = '', weightsHash = '', graphHash = '', runtime = RUNTIME) {
  const np = String(normalizedPrompt || '');
  const ik = Array.isArray(intentKeywords) ? intentKeywords.join(' ') : String(intentKeywords || '');
  const parts = [np, ik, manifestFingerprint, String(runtime || '')];
  const live = [modeMapHash, weightsHash, graphHash].filter(Boolean).join('|');
  if (live) parts.push(live);
  return createHash('sha256').update(parts.join('|')).digest('hex');
}

// Deterministic, content-addressed object serialization (key order independent),
// used by contentHash so a mode-map/weights/graph edit that only reorders object
// keys still yields the same hash (a no-op semantically) while a real content
// change yields a different one.
function stableStringify(value) {
  if (value === null || typeof value !== 'object') return JSON.stringify(value);
  if (Array.isArray(value)) return `[${value.map((item) => stableStringify(item)).join(',')}]`;
  const keys = Object.keys(value).sort();
  return `{${keys.map((k) => `${JSON.stringify(k)}:${stableStringify(value[k])}`).join(',')}}`;
}

// WR-01/WR-02: content-addressed hash of a live routing input (mode-map, weights,
// graph). '' for null/undefined so the caller can skip the fold. NEVER an mtime —
// determinism preserved, cache invalidated only on true content change.
export function contentHash(value) {
  if (value == null) return '';
  return createHash('sha256').update(stableStringify(value), 'utf8').digest('hex');
}

// Read graph.json mtime for cwd (best-effort; returns 0 on any failure or
// when the file is missing). Used to fold the graph's mtime into the cache
// key so a project-side `graphify build` invalidates stale routes.
function readGraphMtime(cwd) {
  try {
    const dir = (cwd && String(cwd)) || process.cwd();
    const p = join(dir, 'graphify-out', 'graph.json');
    if (!existsSync(p)) return 0;
    return statSync(p).mtimeMs;
  } catch {
    return 0;
  }
}

// Insert/update a cache entry with LRU eviction at CACHE_MAX. Mutates and
// returns the cache. hit_count is preserved across re-inserts.
export function writeCache(cache, sig, route, maxSize = CACHE_MAX) {
  if (!cache || typeof cache !== 'object') cache = newCache();
  if (!cache.entries) cache.entries = {};
  if (!Array.isArray(cache.order)) cache.order = [];
  const prev = cache.entries[sig];
  cache.entries[sig] = {
    route,
    ts: Date.now(),
    hit_count: prev ? prev.hit_count : 0,
  };
  // LRU: move to end (most-recent)
  const idx = cache.order.indexOf(sig);
  if (idx >= 0) cache.order.splice(idx, 1);
  cache.order.push(sig);
  while (cache.order.length > maxSize) {
    const evicted = cache.order.shift();
    delete cache.entries[evicted];
  }
  cache.size = cache.order.length;
  return cache;
}

// Atomic write (RTE-06): temp-file + renameSync (atomic on POSIX).
export function saveCache(cache, path = CACHE) {
  const tmp = `${path}.tmp.${process.pid}`;
  writeFileSync(tmp, JSON.stringify(cache));
  renameSync(tmp, path);
}

// --- Telemetry privacy layer (D-20/TEL-01/02/03/Pitfall 8) ----------------
// Plan 01-04 Task 1: hash-only signatures, secret redaction BEFORE hashing,
// 0600 perms on first creation, atomic appendFileSync (each line < 4KB <
// macOS PIPE_BUF 4096), outcome + downstream_invocations present-but-null v1
// so Phase 3 evolution needs no schema migration (TEL-03 seam preservation).
// A deny-rule prompt (.env/secrets) → NO signature logged (deny_filtered only)
// — Pitfall 8 belt-and-braces: even the hash of a secrets-referencing prompt
// is not persisted.

// Secret/PII redaction BEFORE hashing (Pitfall 8 defense-in-depth). Catches
// the common credential shapes: sk-... (OpenAI/Anthropic-style), AKIA... (AWS),
// ghp_.../gho_... (GitHub PAT), xoxb-... (Slack), glpat-... (GitLab), and a
// conservative long-run fallback [A-Za-z0-9_\-]{32,}={0,2} that catches generic
// high-entropy tokens. Replaced with the literal `[REDACTED]` so the hash input
// never includes raw secrets, even if the hash itself is irreversible.
// Case-insensitive (`i` flag) so the patterns still match after `main()`
// lowercases the prompt for `normalizedPrompt` — e.g. `AKIAIOSFODNN7EXAMPLE`
// becomes `akiaiosfodnn7example`, which the case-sensitive `AKIA[0-9A-Z]{16}`
// form would silently miss (CR-02). The 20-char AWS key also falls below the
// 32+ char generic fallback, so without the `i` flag it leaked into the hash.
const SECRET_RE = /(?:sk-[A-Za-z0-9]{20,}|AKIA[0-9A-Z]{16}|ghp_[A-Za-z0-9]{36}|xoxb-[0-9A-Za-z]+|gho_[A-Za-z0-9]{36}|glpat-[A-Za-z0-9_-]{20}|[A-Za-z0-9_\-]{32,}={0,2})/gi;
export function redact(s) {
  return String(s).replace(SECRET_RE, '[REDACTED]');
}

// prompt_signature = sha256(redact(normalizedPrompt) + "|" + intentKeywords.join(" "))
// NEVER raw prompt, NEVER a prefix, NEVER a substring (Pitfall 8 / D-20).
// intentKeywords is [] in v1 (Phase 3 populates); the join keeps the shape stable.
export function promptSignature(normalizedPrompt, intentKeywords) {
  const redacted = redact(String(normalizedPrompt || ''));
  const iks = Array.isArray(intentKeywords) ? intentKeywords.join(' ') : String(intentKeywords || '');
  return createHash('sha256').update(`${redacted}|${iks}`).digest('hex');
}

// Append one JSON line to telemetry.jsonl. Atomic appendFileSync (flag 'a'),
// each line < 4KB (well under macOS PIPE_BUF 4096) → concurrent sessions don't
// interleave (Pitfall 16). On first creation chmod 0600 (owner read/write only,
// Pitfall 8) — idempotent guard: only chmod when we just created the file.
// Wrapped in try/catch — a telemetry write error MUST NOT block injection
// (fail-open: still return the additionalContext to the caller).
export function logTelemetry(entry, telemetryPath = TELEMETRY) {
  try {
    const line = JSON.stringify(entry) + '\n';
    const existedBefore = existsSync(telemetryPath);
    appendFileSync(telemetryPath, line, { flag: 'a' });
    if (!existedBefore) {
      try { chmodSync(telemetryPath, 0o600); } catch { /* perms best-effort */ }
    }
  } catch {
    // Never block injection on a telemetry write failure (fail-open).
  }
}

// Phase 33 — measure-only suggestion -> invocation observer. The observer is
// deliberately independent of routing and health outcomes: it records only
// accepted/rejected/no_signal evidence for the next calibration phase.
const SHADOW_OUTCOMES = Object.freeze(['accepted', 'rejected', 'no_signal']);
const SHADOW_EVENTS = new Set(['UserPromptExpansion', 'PostToolUse', 'PostToolUseFailure', 'Stop']);
const SHADOW_TOOLS = new Set(['Skill', 'Agent', 'Task']);
const SHADOW_MAX_AGE_MS = 15 * 60 * 1000;
const CALIBRATION_MIN_ACCEPTED = 50;
const CALIBRATION_DEFAULTS = Object.freeze({ T_high: 0.591, T_low: 0.291, M: 0.191 });
const CALIBRATION_PRIOR_STRENGTH = 50;
const CALIBRATION_DAMPING = 0.3;
const CALIBRATION_MAX_HYSTERESIS = 0.05;

function shadowToken(value) {
  return String(value || '').trim().replace(/^\/+/, '').toLowerCase();
}

function shadowHash(value) {
  return createHash('sha256').update(stableStringify(value), 'utf8').digest('hex');
}

function readJsonLines(path) {
  if (!existsSync(path)) return [];
  try {
    return readFileSync(path, 'utf8').split(/\r?\n/).filter(Boolean).flatMap((line) => {
      try {
        const value = JSON.parse(line);
        return value && typeof value === 'object' && !Array.isArray(value) ? [value] : [];
      } catch { return []; }
    });
  } catch { return []; }
}

function readShadowState(path) {
  try {
    const value = JSON.parse(readFileSync(path, 'utf8'));
    return { settled: new Set(Array.isArray(value?.settled) ? value.settled.filter((id) => /^[a-f0-9]{64}$/.test(id)) : []) };
  } catch { return { settled: new Set() }; }
}

function writeShadowState(path, settled) {
  try {
    mkdirSync(join(path, '..'), { recursive: true, mode: 0o700 });
    const tmp = `${path}.tmp.${process.pid}`;
    writeFileSync(tmp, JSON.stringify({ settled: [...settled].slice(-256) }) + '\n', { mode: 0o600 });
    renameSync(tmp, path);
  } catch { /* observation is advisory */ }
}

function shadowCandidateId(row) {
  if (/^[a-f0-9]{64}$/.test(row?.suggestion_id || '')) return row.suggestion_id;
  return shadowHash({
    ts: row?.ts,
    prompt_signature: row?.prompt_signature,
    runtime: row?.runtime,
    suggested_mode: row?.suggested_mode,
    suggested_skills: Array.isArray(row?.suggested_skills) ? row.suggested_skills : [],
    suggested_agents: Array.isArray(row?.suggested_agents) ? row.suggested_agents : [],
  });
}

function freshShadowCandidate({ telemetryPath, runtime = RUNTIME, now = Date.now(), maxAgeMs = SHADOW_MAX_AGE_MS, settled = new Set(), invoked = '' } = {}) {
  const rows = readJsonLines(telemetryPath || TELEMETRY);
  const candidates = [];
  for (let i = rows.length - 1; i >= 0; i -= 1) {
    const row = rows[i];
    const ts = Number(row.ts);
    const suggestionId = shadowCandidateId(row);
    const capabilities = [row.suggested_mode, ...(row.suggested_skills || []), ...(row.suggested_agents || [])]
      .map(shadowToken).filter(Boolean);
    if (row.runtime !== runtime || !/^[a-f0-9]{64}$/.test(row.prompt_signature || '')
      || !Number.isSafeInteger(ts) || now - ts < 0 || now - ts > maxAgeMs
      || row.cache_hit === true || row.cache_status === 'hit'
      || settled.has(suggestionId) || capabilities.length === 0) continue;
    candidates.push({ row, suggestionId, capabilities: new Set(capabilities) });
  }
  return candidates.find((candidate) => invoked && candidate.capabilities.has(invoked)) || candidates[0] || null;
}

function eventCapability(payload) {
  if (payload?.hook_event_name === 'UserPromptExpansion') return shadowToken(payload.command_name);
  if (!SHADOW_TOOLS.has(payload?.tool_name)) return '';
  const input = payload.tool_input;
  if (!input || typeof input !== 'object') return '';
  return shadowToken(input.skill || input.name || input.subagent_type);
}

export function readShadowOutcomes({ shadowPath = SHADOW_LOG } = {}) {
  return readJsonLines(shadowPath).filter((row) => SHADOW_OUTCOMES.includes(row.outcome));
}

export function appendShadowOutcome(record, { shadowPath = SHADOW_LOG } = {}) {
  if (!record || !SHADOW_OUTCOMES.includes(record.outcome)) return { status: 'ignored', reason_code: 'invalid_shadow_outcome' };
  try {
    mkdirSync(join(shadowPath, '..'), { recursive: true, mode: 0o700 });
    const existedBefore = existsSync(shadowPath);
    appendFileSync(shadowPath, JSON.stringify(record) + '\n', { flag: 'a', mode: 0o600 });
    if (!existedBefore) try { chmodSync(shadowPath, 0o600); } catch {}
    return { status: 'stored', outcome: record.outcome, suggestion_id: record.suggestion_id };
  } catch { return { status: 'ignored', reason_code: 'shadow_write_failed' }; }
}

function calibrationDefaults(defaults = CALIBRATION_DEFAULTS) {
  return {
    T_high: Number.isFinite(defaults?.T_high) ? defaults.T_high : CALIBRATION_DEFAULTS.T_high,
    T_low: Number.isFinite(defaults?.T_low) ? defaults.T_low : CALIBRATION_DEFAULTS.T_low,
    M: Number.isFinite(defaults?.M) ? defaults.M : CALIBRATION_DEFAULTS.M,
  };
}

function validCalibrationThresholds(thresholds) {
  return thresholds && typeof thresholds === 'object' && !Array.isArray(thresholds)
    && ['T_high', 'T_low', 'M'].every((key) => Number.isFinite(thresholds[key]) && thresholds[key] >= 0 && thresholds[key] <= 1)
    && thresholds.T_low <= thresholds.T_high;
}

function boundedThreshold(value, baseline, maxHysteresis = CALIBRATION_MAX_HYSTERESIS) {
  return Number(Math.min(1, Math.max(0, Math.min(baseline + maxHysteresis,
    Math.max(baseline - maxHysteresis, value)))).toFixed(6));
}

function shadowCorpusHash(rows) {
  return shadowHash(rows.map((row) => ({
    suggestion_id: row.suggestion_id,
    prompt_signature: row.prompt_signature,
    suggested_mode: row.suggested_mode || null,
    suggested_skills: Array.isArray(row.suggested_skills) ? row.suggested_skills : [],
    suggested_agents: Array.isArray(row.suggested_agents) ? row.suggested_agents : [],
    outcome: row.outcome,
    runtime: row.runtime,
    source_event: row.source_event,
  })).sort((a, b) => String(a.suggestion_id).localeCompare(String(b.suggestion_id))));
}

export function deriveCalibrationThresholds(rows, {
  defaults = CALIBRATION_DEFAULTS,
  minAccepted = CALIBRATION_MIN_ACCEPTED,
  priorStrength = CALIBRATION_PRIOR_STRENGTH,
  damping = CALIBRATION_DAMPING,
  maxHysteresis = CALIBRATION_MAX_HYSTERESIS,
} = {}) {
  const safeDefaults = calibrationDefaults(defaults);
  const counts = emptyShadowCounts();
  for (const row of Array.isArray(rows) ? rows : []) {
    if (SHADOW_OUTCOMES.includes(row?.outcome)) counts[row.outcome] += 1;
  }
  if (counts.accepted < minAccepted) {
    return { status: 'insufficient_evidence', thresholds: safeDefaults, counts, corpus_hash: shadowCorpusHash(Array.isArray(rows) ? rows : []) };
  }
  const settled = counts.accepted + counts.rejected;
  const thresholds = {};
  for (const key of Object.keys(safeDefaults)) {
    const prior = safeDefaults[key] * priorStrength;
    const posterior = (prior + counts.accepted) / (priorStrength + settled);
    const damped = safeDefaults[key] * (1 - damping) + posterior * damping;
    thresholds[key] = boundedThreshold(damped, safeDefaults[key], maxHysteresis);
  }
  // Keep the confidence boundaries ordered even when a future default changes.
  thresholds.T_low = Math.min(thresholds.T_low, thresholds.T_high);
  return {
    status: 'ready',
    thresholds,
    counts,
    corpus_hash: shadowCorpusHash(Array.isArray(rows) ? rows : []),
    prior_strength: priorStrength,
    damping,
    max_hysteresis: maxHysteresis,
  };
}

function atomicCalibrationWrite(path, value) {
  mkdirSync(join(path, '..'), { recursive: true, mode: 0o700 });
  const tmp = `${path}.tmp.${process.pid}.${Date.now()}`;
  writeFileSync(tmp, JSON.stringify(value) + '\n', { mode: 0o600 });
  try { chmodSync(tmp, 0o600); } catch {}
  renameSync(tmp, path);
}

export function writeEpochCalibration(record, { calibrationPath = CALIBRATION_PATH } = {}) {
  if (!record || record.status !== 'ready'
    || !/^[a-f0-9]{64}$/.test(record.manifest_fingerprint || '')
    || !/^[a-f0-9]{64}$/.test(record.corpus_hash || '')
    || !record.mode_map_version || !validCalibrationThresholds(record.thresholds)) {
    return { status: 'ignored', reason_code: 'invalid_calibration_record' };
  }
  try {
    let previous = null;
    try { previous = JSON.parse(readFileSync(calibrationPath, 'utf8')); } catch {}
    const value = {
      schema_version: 1,
      manifest_fingerprint: record.manifest_fingerprint,
      mode_map_version: record.mode_map_version,
      corpus_hash: record.corpus_hash,
      thresholds: record.thresholds,
      evidence: record.counts,
      calibration_status: 'active',
      rollback_thresholds: previous?.thresholds || CALIBRATION_DEFAULTS,
      generated_at: record.generated_at || Date.now(),
    };
    atomicCalibrationWrite(calibrationPath, value);
    return { status: 'stored', calibration: value };
  } catch { return { status: 'ignored', reason_code: 'calibration_write_failed' }; }
}

export function rollbackEpochCalibration({ calibrationPath = CALIBRATION_PATH, defaults = CALIBRATION_DEFAULTS, now = Date.now() } = {}) {
  try {
    const current = JSON.parse(readFileSync(calibrationPath, 'utf8'));
    if (!current || typeof current !== 'object' || !current.thresholds) return { status: 'ignored', reason_code: 'no_active_calibration' };
    const value = {
      ...current,
      thresholds: calibrationDefaults(defaults),
      calibration_status: 'rolled_back',
      rolled_back_at: now,
    };
    atomicCalibrationWrite(calibrationPath, value);
    return { status: 'rolled_back', calibration: value };
  } catch { return { status: 'ignored', reason_code: 'calibration_rollback_failed' }; }
}

export function maybeCalibrateShadow({
  shadowPath = SHADOW_LOG, calibrationPath = CALIBRATION_PATH,
  manifestFingerprint, modeMapVersion = 'unknown', now = Date.now(),
  defaults = CALIBRATION_DEFAULTS,
} = {}) {
  const rows = readShadowOutcomes({ shadowPath });
  const derived = deriveCalibrationThresholds(rows, { defaults });
  if (derived.status !== 'ready') return derived;
  const record = {
    ...derived,
    manifest_fingerprint: manifestFingerprint,
    mode_map_version: String(modeMapVersion),
    generated_at: now,
  };
  return writeEpochCalibration(record, { calibrationPath });
}

export function observeShadowEvent(payload, {
  telemetryPath = TELEMETRY, shadowPath = SHADOW_LOG, statePath = SHADOW_STATE,
  calibrationPath = CALIBRATION_PATH, manifestFingerprint = '', modeMapVersion = 'unknown',
  runtime = RUNTIME, now = Date.now(), maxAgeMs = SHADOW_MAX_AGE_MS,
} = {}) {
  const event = payload?.hook_event_name;
  if (!SHADOW_EVENTS.has(event)) return { status: 'ignored', reason_code: 'unsupported_event' };
  if (event === 'Stop' && payload?.stop_hook_active === true) return { status: 'ignored', reason_code: 'stop_hook_active' };
  if ((event === 'PostToolUse' || event === 'PostToolUseFailure') && !SHADOW_TOOLS.has(payload?.tool_name)) {
    return { status: 'ignored', reason_code: 'unsupported_tool' };
  }
  const invoked = event === 'Stop' ? '' : eventCapability(payload);
  const state = readShadowState(statePath);
  const candidate = freshShadowCandidate({ telemetryPath, runtime, now, maxAgeMs, settled: state.settled, invoked });
  if (!candidate) return { status: 'ignored', reason_code: 'no_fresh_suggestion' };
  const outcome = event === 'Stop'
    ? 'no_signal'
    : (event === 'PostToolUse' && candidate.capabilities.has(invoked) ? 'accepted' : 'rejected');
  const record = {
    schema_version: 1,
    timestamp_ms: now,
    suggestion_id: candidate.suggestionId,
    prompt_signature: candidate.row.prompt_signature,
    suggested_mode: candidate.row.suggested_mode || null,
    suggested_skills: Array.isArray(candidate.row.suggested_skills) ? candidate.row.suggested_skills.map(String).slice(0, 16) : [],
    suggested_agents: Array.isArray(candidate.row.suggested_agents) ? candidate.row.suggested_agents.map(String).slice(0, 16) : [],
    invocation_signature: invoked ? shadowHash({ capability: invoked }) : null,
    outcome,
    runtime,
    source_event: event,
  };
  const result = appendShadowOutcome(record, { shadowPath });
  if (result.status === 'stored') {
    state.settled.add(candidate.suggestionId);
    writeShadowState(statePath, state.settled);
    const calibration = maybeCalibrateShadow({
      shadowPath, calibrationPath, manifestFingerprint, modeMapVersion, now,
    });
    return { ...result, outcome, calibration_status: calibration.status };
  }
  return result;
}

function emptyShadowCounts() {
  return { accepted: 0, rejected: 0, no_signal: 0 };
}

function sortedShadowCounts(counts) {
  return Object.fromEntries(Object.keys(counts).sort().map((key) => [key, counts[key]]));
}

export function buildShadowDivergenceReport({ shadowPath = SHADOW_LOG } = {}) {
  const byMode = {};
  const bySkill = {};
  const rows = readShadowOutcomes({ shadowPath });
  const add = (target, key, outcome) => {
    if (!key) return;
    if (!target[key]) target[key] = emptyShadowCounts();
    target[key][outcome] += 1;
  };
  for (const row of rows) {
    add(byMode, row.suggested_mode, row.outcome);
    for (const skill of row.suggested_skills || []) add(bySkill, skill, row.outcome);
  }
  return {
    schema_version: 1,
    calibration_enabled: false,
    total: rows.length,
    by_mode: sortedShadowCounts(byMode),
    by_skill: sortedShadowCounts(bySkill),
  };
}

// Phase 3 / EVO-02: atomic counter + worker spawn (D-03). Increments the
// .evolve-trigger file on every prompt; on counter % 200 === 0, spawns the
// worker detached + stdio:'ignore' + unref() so the hook returns immediately
// (Pitfall 6: the worker must not block the hot path).
function bumpEvolveTrigger() {
  let n = 0;
  try { n = parseInt(readFileSync(TRIGGER, 'utf8').trim(), 10) || 0; } catch { n = 0; }
  n += 1;
  const tmp = `${TRIGGER}.tmp.${process.pid}`;
  writeFileSync(tmp, String(n));
  renameSync(tmp, TRIGGER);
  if (n % EVOLVE_TRIGGER_N === 0) {
    try {
      spawn(process.execPath, [WORKER_PATH], { detached: true, stdio: 'ignore' }).unref();
    } catch {}
  }
}

// --- Graphify stub heuristic (GRF-01/§12) ---------------------------------

// Phase 1 stub: heuristic fires on codebase prompts (symbols/file paths/
// "how does"/refactor/architecture). When it fires, status is graph_missing
// (Phase 1 NEVER issues a real query — that is Phase 2/GRF-02). Returns
// {queried, status} where queried=true means the heuristic fired (considered
// the graph), and status ∈ not_triggered | graph_missing.
const GRAPH_REGEX_PRIMARY =
  /\b(how\s+does|how\s+do|where\s+is|refactor|architecture|symbol|file\s+path)\b/i;
const GRAPH_REGEX_PATH = /\/([a-z0-9_-]+\/)+[a-z0-9_-]+\.[a-z]{1,4}/i;
const GRAPH_REGEX_SYMBOL =
  /(^|[^\w])([A-Z][a-z]+[A-Z]\w*|class\s+\w+|def\s+\w+|function\s+\w+)/;

export function graphifyHeuristic(prompt, cwd) {
  const p = String(prompt || '');
  if (!p) return { queried: false, status: 'not_triggered', symbols: [], elapsed_ms: 0, boostIds: new Set() };
  const fired =
    GRAPH_REGEX_PRIMARY.test(p) ||
    GRAPH_REGEX_PATH.test(p) ||
    GRAPH_REGEX_SYMBOL.test(p);
  if (!fired) return { queried: false, status: 'not_triggered', symbols: [], elapsed_ms: 0, boostIds: new Set() };
  // Phase 2: delegate to graphifyQuery (Plan 02-01 primitive). Public signature
  // preserved (D-18): `queried: true` means "the heuristic considered the graph"
  // (Phase-1 contract — graphify-stub.test.mjs depends on this). graphifyQuery's
  // `graph_queried` field reports whether the file was actually read, which is
  // what telemetry now logs as `graphify_queried` via `decision.graphify_queried`.
  // New fields (symbols, elapsed_ms, boostIds) feed applyGraphBoost + formatGraphBlock
  // + telemetry graph_status enum.
  const result = graphifyQuery(p, cwd, 8);
  return {
    queried: true,
    status: result.graph_status,
    symbols: result.symbols,
    elapsed_ms: result.elapsed_ms,
    boostIds: result.boostIds,
    // WR-02: propagated so cacheKey can fold the graph content signature.
    content_hash: result.content_hash,
  };
}

// composeWithCap (Plan 02-02 / D-13): combines a route block and a graph block
// under the 500-token cap with graph-first drop on conflict. The route block
// is always preserved (D-13 priority order: graph → route). Pure + exported
// for direct unit testing.
export function composeWithCap(routeBlock, graphBlock) {
  if (!routeBlock && !graphBlock) return '';
  if (!routeBlock) return graphBlock;
  if (!graphBlock) return routeBlock;
  const routeTok = tokenCount(routeBlock);
  const graphTok = tokenCount(graphBlock);
  const cap = TOKEN_CAP - 2; // 2-token safety margin (Phase 1 D from Plan 01-03)
  if (routeTok + graphTok <= cap) return routeBlock + '\n\n' + graphBlock;
  return routeBlock; // graph dropped first
}

// --- Graphify query primitives (Plan 02-01 / GRF-02) ---------------------
// Pure functions: graphifyQuery, formatGraphBlock, applyGraphBoost.
// collectGraphNodes is a private helper exported only for unit-test reach.

// Flatten graphJson.nodes[] + graphJson.graph.hyperedges[] into candidate
// rows for BM25. Per RESEARCH.md §2: ignore the top-level `hyperedges` (legacy
// duplicate) and `links` (edge metadata). Hyperedges are cluster anchors and
// get community = -1 sentinel (they are not members of any single community).
export function collectGraphNodes(graphJson) {
  if (!graphJson || typeof graphJson !== 'object') return [];
  const out = [];
  const nodes = Array.isArray(graphJson.nodes) ? graphJson.nodes : [];
  for (const n of nodes) {
    if (!n || !n.id) continue;
    const id = String(n.id);
    const label = n.label != null ? String(n.label) : id;
    const community = typeof n.community === 'number' ? n.community : -1;
    out.push({ id, label, community });
  }
  const hyperedges =
    graphJson.graph && Array.isArray(graphJson.graph.hyperedges)
      ? graphJson.graph.hyperedges
      : [];
  for (const h of hyperedges) {
    if (!h || !h.id) continue;
    const id = String(h.id);
    const label = h.label != null ? String(h.label) : id;
    out.push({ id, label, community: -1 });
  }
  return out;
}

// Score the graph against the prompt via inline BM25 (D-01, D-04). Pure given
// a cwd: reads cwd/graphify-out/graph.json, enforces 50MB + 20K guards, and
// returns {symbols, graph_queried, graph_status, elapsed_ms, boostIds}.
// Never throws (D-10): any failure returns graph_status: 'error' or
// 'graph_missing' and the caller routes on the manifest alone.
export function graphifyQuery(prompt, cwd, k = 8) {
  const t0 = process.hrtime.bigint();
  const elapsed = () => Number(process.hrtime.bigint() - t0) / 1e6;
  const dir = (cwd && String(cwd)) || process.cwd();
  const graphPath = join(dir, 'graphify-out', 'graph.json');
  if (!existsSync(graphPath)) {
    return {
      symbols: [],
      graph_queried: false,
      graph_status: 'graph_missing',
      elapsed_ms: elapsed(),
      boostIds: new Set(),
    };
  }
  let stat;
  try {
    stat = statSync(graphPath);
  } catch {
    return {
      symbols: [],
      graph_queried: true,
      graph_status: 'error',
      elapsed_ms: elapsed(),
      boostIds: new Set(),
    };
  }
  if (stat && typeof stat.size === 'number' && stat.size > GRAPH_FILE_SIZE_GUARD) {
    return {
      symbols: [],
      graph_queried: true,
      graph_status: 'error',
      elapsed_ms: elapsed(),
      boostIds: new Set(),
    };
  }
  try {
    const raw = readFileSync(graphPath, 'utf8');
    const graphJson = JSON.parse(raw);
    const candidates = collectGraphNodes(graphJson);
    if (candidates.length > GRAPH_NODE_COUNT_GUARD) {
      return {
        symbols: [],
        graph_queried: true,
        graph_status: 'error',
        elapsed_ms: elapsed(),
        boostIds: new Set(),
      };
    }
    // Build a BM25 corpus over (id + ' ' + label) per candidate. Reuses
    // tokenize + bm25Score from Phase 1 verbatim (D-01, D-04).
    const corpus = candidates.map((c) => {
      const toks = tokenize(`${c.id} ${c.label}`);
      const tf = new Map();
      for (const t of toks) tf.set(t, (tf.get(t) || 0) + 1);
      return { entry: c, name: c.id, tokens: tf, dl: toks.length };
    });
    const queryTokens = tokenize(prompt);
    const scored = bm25Score(queryTokens, corpus);
    const topK = scored.slice(0, k).map((s) => ({
      id: s.name,
      label: s.entry.label,
      community: s.entry.community,
      score: s.score,
    }));
    if (topK.length === 0) {
      return {
        symbols: [],
        graph_queried: true,
        graph_status: 'empty',
        elapsed_ms: elapsed(),
        boostIds: new Set(),
      };
    }
    const boostIds = new Set(topK.map((s) => s.id));
    return {
      symbols: topK,
      graph_queried: true,
      graph_status: 'ok',
      elapsed_ms: elapsed(),
      boostIds,
      // WR-02: content-addressed signature of graph.json so cacheKey can fold it
      // (graph build -> new content -> new key -> stale graph-boosted route
      // recomputed) WITHOUT re-introducing a raw absolute mtime.
      content_hash: createHash('sha256').update(raw, 'utf8').digest('hex'),
    };
  } catch {
    return {
      symbols: [],
      graph_queried: true,
      graph_status: 'error',
      elapsed_ms: elapsed(),
      boostIds: new Set(),
    };
  }
}

// Format a graph block (D-05) capped at (GRAPH_TOKEN_CAP - 2) * 4 chars via
// the same ~4-chars-per-token approximation Phase 1 uses (tokenCount).
// Drops lowest-scored symbols first on overflow. Truncates each label to
// 50 chars with an ellipsis suffix. Returns '' for empty / non-array input.
// D-06: no file paths in the output.
export function formatGraphBlock(symbols) {
  if (!Array.isArray(symbols) || symbols.length === 0) return '';
  const cap = (GRAPH_TOKEN_CAP - 2) * 4; // 2-token safety margin, 4 chars/token
  const sorted = symbols
    .slice()
    .sort((a, b) => (b.score || 0) - (a.score || 0));
  let out = 'Symbols: ';
  for (let i = 0; i < sorted.length; i++) {
    const s = sorted[i];
    const rawLabel = s.label != null ? String(s.label) : '';
    const label = rawLabel.length > 50 ? rawLabel.slice(0, 49) + '…' : rawLabel;
    const id = s.id != null ? String(s.id) : '';
    const community = typeof s.community === 'number' ? s.community : -1;
    const piece = `${label} (${id}, ${community})`;
    const sep = i === 0 ? '' : ', ';
    if ((out + sep + piece).length > cap) {
      if (i === 0 && out.length + piece.length > cap) {
        // Even a single symbol is too long: emit as much as fits, no trailing separator.
        return out + piece.slice(0, Math.max(0, cap - out.length));
      }
      break; // drop the rest (lowest-scored first)
    }
    out += sep + piece;
  }
  return out;
}

// Add `amount` to the score of any entry whose name is in the intersection of
// topK and manifestIdSet (D-07). PURE: returns a new array of shallow-cloned
// objects; the input is never mutated. Case-insensitive name match. Accepts
// Array or Set/Iterable for topK and manifestIdSet.
export function applyGraphBoost(scored, topK, manifestIdSet, amount = GRAPH_BOOST) {
  if (!Array.isArray(scored)) return [];
  const toArr = (x) => (Array.isArray(x) ? x : (x && typeof x[Symbol.iterator] === 'function') ? Array.from(x) : []);
  const topKSet = new Set(toArr(topK).map((x) => String(x).toLowerCase()));
  const manifestSet = new Set(toArr(manifestIdSet).map((x) => String(x).toLowerCase()));
  return scored.map((s) => {
    const nameLower = String(s.name || '').toLowerCase();
    if (topKSet.has(nameLower) && manifestSet.has(nameLower)) {
      return { ...s, score: (s.score || 0) + amount };
    }
    return { ...s };
  });
}

// --- Wave 3: guards + injection formatting (Plan 01-03) -------------------

// GRD-05 deny-rule path detection (D-17). Returns true if the prompt references
// a deny-rule path: `.env`, `.secrets`, or any path in the settings.json
// permissions.deny list (glob markers stripped for the substring test). When
// true, the router skips routing entirely and logs `deny_filtered` — no
// signature is logged either (Pitfall 8 belt-and-braces). `settings` is an
// optional parsed settings.json object (only its permissions.deny array is
// consulted). Pure + exported for direct unit testing.
const DENY_PATH_RE = /(^|[^A-Za-z0-9])(\.env|\.secrets)([^A-Za-z0-9]|$)/i;
export function denyPathDetect(prompt, settings = null) {
  if (typeof prompt !== 'string') return false;
  if (DENY_PATH_RE.test(prompt)) return true;
  if (settings && settings.permissions && Array.isArray(settings.permissions.deny)) {
    for (const p of settings.permissions.deny) {
      if (!p) continue;
      // strip glob markers for a literal substring test
      const cleaned = String(p).replace(/[*?]/g, '');
      if (cleaned && prompt.includes(cleaned)) return true;
    }
  }
  return false;
}

// GRD-03 ralph two-gate: extract a genuine verifiable done-criterion as a
// LITERAL verbatim phrase from the prompt (D-15: quote, never synthesize).
// Returns the literal substring if a verifiable criterion is present, else
// null (→ do NOT route to ralph-loop, fall back to inline mode). Each regex
// captures (group 1) the exact phrase as it appears in the prompt.
const VERIFIABLE_PATTERNS = [
  /\b(all tests pass)\b/i,
  /\b(tests? (?:all )?pass)\b/i,
  /\b(they all pass)\b/i,
  /\b(pytest exits 0)\b/i,
  /\b(npm run build && npm test)\b/i,
  /\b(git diff --quiet)\b/i,
  /\b(coverage\s*[>=]+\s*\d+%?)\b/i,
  /\b(dist\/[a-z0-9_.-]+\.html exists)\b/i,
  /\b(max \d+ tries)\b/i,
  /\b(max \d+ iterations)\b/i,
  /\b(exit code 0)\b/i,
];
export function extractVerifiablePromise(prompt) {
  if (typeof prompt !== 'string') return null;
  for (const re of VERIFIABLE_PATTERNS) {
    const m = prompt.match(re);
    if (m && m[1]) return m[1]; // literal substring the user provided
  }
  return null;
}

// Apply all guards to a computed route. Returns { route, guards_fired }.
//   route       — the route object from scoring (may be null on no-match)
//   prompt      — the raw user prompt (for deny/ralph checks)
//   manifest    — parsed manifest (for GRD-01 flagged-agent re-score)
//   modeMap     — parsed mode-map (for thresholds on the flagged re-score)
//   ctx         — optional { queryTokens, thresholds } for the GRD-01 demote
//                 check (re-scores the flagged-only pool against the query)
// Pure + exported for direct unit testing. Does NOT implement telemetry.
export function applyGuards(route, prompt, manifest, modeMap, ctx = {}) {
  const guards_fired = [];

  // GRD-05 deny-rule — skip routing entirely, no signature logged.
  if (denyPathDetect(prompt)) {
    guards_fired.push('deny_filtered');
    return { route: null, guards_fired };
  }

  // GRD-01 MCP demote: re-score the flagged-only pool; if the top flagged
  // agent would have scored High, demote the route to warn. The auto-pool
  // (buildCorpus) already excludes flagged agents, so a flagged agent can
  // never be the auto-route's top — this check surfaces the "would have been
  // the top candidate" case as a warn-tier injection instead of a silent miss.
  if (route && route.invoke_kind !== 'warn' && ctx.queryTokens && manifest) {
    const flaggedAgents = (manifest.agents || []).filter(
      (a) => Array.isArray(a.requires_mcp_not_in_manifest) && a.requires_mcp_not_in_manifest.length > 0
    );
    if (flaggedAgents.length) {
      const flaggedCorpus = [];
      for (const a of flaggedAgents) {
        const name = String(a.name || '');
        const desc = String(a.description || '');
        const summary = a.summary ? String(a.summary) : `${name} ${desc}`;
        const docText = `${name} ${name} ${name} ${desc} ${summary}`;
        const toks = tokenize(docText);
        const tf = new Map();
        for (const t of toks) tf.set(t, (tf.get(t) || 0) + 1);
        flaggedCorpus.push({ entry: a, name, tokens: tf, dl: toks.length });
      }
      const fScored = bm25Score(ctx.queryTokens, flaggedCorpus);
      if (fScored.length) {
        const fNormed = normalize(fScored);
        const fTop = fNormed[0];
        const fRunner = fNormed[1];
        const T = ctx.thresholds || (modeMap && modeMap.thresholds) || { T_high: 0.6, T_low: 0.3, M: 0.2 };
        const fTier = confidenceTier(fTop.norm, fRunner ? fRunner.norm : 0, T);
        // Only demote when the flagged agent would actually have been the top
        // auto-pool candidate (its raw BM25 score >= the auto-pool top's raw
        // score). Without this, a single-agent flagged pool normalizes fTop.norm
        // to 1.0 → margin 1.0 → always 'high' → demotes correct routes whose
        // real winner is a valid skill/command (GRD-01 intent, not over-fire).
        const mcp = (flaggedAgents.find((a) => a.name === fTop.name) || {}).requires_mcp_not_in_manifest[0] || 'unknown';
        const explicitMissingMcp = mcp && String(prompt || '').toLowerCase().includes(String(mcp).toLowerCase());
        if (fTier === 'high' && (explicitMissingMcp || ctx.autoTopScore == null || fTop.score >= ctx.autoTopScore)) {
          guards_fired.push(`mcp_demote:${fTop.name}:${mcp}`);
          route = {
            ...route,
            invoke_kind: 'warn',
            tier: 'high',
            warning: `Agent ${fTop.name} needs MCP ${mcp} which is not in manifest — wire it first`,
            mode: null,
            recommended_skills: [],
            recommended_agents: [],
            args_hint: null,
          };
        }
      }
    }
  }

  // GRD-03 ralph two-gate. If the matched mode-map entry is ralph-loop, extract
  // a verbatim verifiable promise; if none → fall back to inline mode (never
  // fabricate a promise — D-15/ralph-loop no-lying rule).
  if (route && route.mode === 'ralph-loop') {
    const promise = extractVerifiablePromise(prompt);
    if (!promise) {
      guards_fired.push('no_verifiable_done_criteria');
      route = {
        ...route,
        mode: null,
        invoke_kind: null,
        args_hint: null,
        fallback: 'inline',
      };
    } else {
      // Derive a task description from the prompt by stripping the verifiable
      // promise phrase + trailing conjunctions/max-iterations noise. Falls back
      // to the trimmed prompt. CR-01: without this, slashLine() emits the
      // literal placeholder "the task" because route.task is never set by
      // main() (which builds the route from scoring, with no task field).
      const stripped = prompt.replace(new RegExp(escapeRegex(promise), 'i'), '')
        .replace(/\b(max \d+ tries|max \d+ iterations)\b/gi, '')
        .replace(/\b(until|keep running|iterate|,)\s*$/gi, '')
        .replace(/\s+/g, ' ')
        .trim();
      const task = stripped || prompt.trim();
      route = { ...route, completion_promise: promise, task };
    }
  }

  return { route, guards_fired };
}

// --- formatInjection (INJ-01..06 / D-10 / D-11) ---------------------------
// Turns a route decision into model-readable additionalContext text per
// invoke_kind × tier. D-01 discipline: the instruction text is a MODEL
// instruction (`Run /gsd-<mode>`, `Use the Skill tool to invoke`, `Dispatch
// agent`) — the model reads it and acts; the harness never auto-runs slashes.
//
// Block layout (Pitfall 2 — load-bearing, prevents dead injection):
//   \n\n
//   <!-- router-inject mode=<mode> tier=<tier> sig=<short hash> -->
//   Reasoning: <one sentence why this mode + these skills/agents>
//   <slash on its own line at column 0, no backticks, no leading whitespace>
//   <skill/agent imperatives>
//   <!-- /router-inject -->
//
// Low tier → '' (true pass-through, no sentinel). warn kind → the MCP-missing
// warning, no dispatch. Medium tier → text-only suggestion (NO slash
// instruction line — Pitfall 2: a slash at Medium would fire when the model
// reads it). ≤500-token cap enforced with priority drop order.

// Cheap ~4-chars-per-token approximation (INJ-06).
export function tokenCount(text) {
  return Math.ceil(String(text || '').length / 4);
}

const TOKEN_CAP = 500;
// Graphify block constants (Plan 02-01 / GRF-02 / D-13). GRAPH_TOKEN_CAP=200 is
// a measured bump from the CONTEXT.md 150-token estimate: 8 symbols at 50-char
// labels measured ~192 tokens (RESEARCH.md §8), so 200 preserves K=8 with
// ~225-token slack in the 500-token total. GRAPH_FILE_SIZE_GUARD and
// GRAPH_NODE_COUNT_GUARD are belt-and-braces refusals (THREAT T-02.1-01/02).
const GRAPH_TOKEN_CAP = 200;
const GRAPH_BOOST = 0.15;
const GRAPH_FILE_SIZE_GUARD = 50 * 1024 * 1024;
const GRAPH_NODE_COUNT_GUARD = 20000;

// Build the reasoning line (D-10/D-11 — load-bearing, lets the user catch
// wrong picks). One sentence summarizing why this mode + skills/agents.
function buildReasoning(route) {
  const mode = route.mode || (route.invoke_kind === 'warn' ? 'warn' : 'inline');
  const skills = (route.recommended_skills || []).filter(Boolean);
  const agents = (route.recommended_agents || []).filter(Boolean);
  const parts = [];
  if (route.invoke_kind === 'warn') {
    return `MCP-missing agent flagged — wire the MCP before dispatching.`;
  }
  if (route.mode) parts.push(`${route.mode} matches this prompt's signals`);
  if (skills.length) parts.push(`${skills.length} skill${skills.length > 1 ? 's' : ''} fit`);
  if (agents.length) parts.push(`${agents.length} agent${agents.length > 1 ? 's' : ''} fit`);
  if (parts.length === 0) parts.push('best available route for this prompt');
  return parts.join('; ') + '.';
}

// The slash instruction line at column 0, no backticks, no leading whitespace.
function slashLine(route, reasoning) {
  const mode = route.mode || '';
  const args = route.args_hint || '';
  if (route.mode === 'ralph-loop' && route.completion_promise) {
    const task = (route.task || '').replace(/"/g, "'") || 'the task';
    const promise = route.completion_promise.replace(/"/g, "'");
    return `Run /ralph-loop "${task}" --completion-promise "${promise}" because ${reasoning}`;
  }
  return `Run /${mode} ${args}`.replace(/\s+$/, '') + ` because ${reasoning}`;
}

// Skill imperative (Pitfall 17 — imperative, not suggestive).
function skillLine(name) {
  return `Use the Skill tool to invoke ${name} now, because it fits this task.`;
}

// Agent imperative (Pitfall 17).
function agentLine(name) {
  return `Dispatch agent ${name} for this subtask, because it fits.`;
}

// Assemble the block (without the leading \n\n) from open/reasoning/lines/close.
function assembleBlock(route, sigHash, reasoning, bodyLines) {
  const mode = route.mode || '';
  const tier = route.tier || '';
  const open = `<!-- router-inject mode=${mode} tier=${tier} sig=${sigHash} -->`;
  const close = `<!-- /router-inject -->`;
  return [open, `Reasoning: ${reasoning}`, ...bodyLines, close].join('\n');
}

// SAF-04 hard render-count cap. Pure function: caps recommended_skills to the
// first 3 and recommended_agents to the first 2, preserving author priority
// order (skills[0] is primary — consistent with formatInjection's
// primarySkill = skills[0] semantics). Sets _render_cap_truncated (a
// telemetry-only flag) when the input exceeds either cap; the flag is stripped
// from the route before formatInjection produces injection output. Called
// before formatInjection on BOTH the cache-hit and fresh-route paths. Never
// throws — returns the route unchanged on any error.
export function capRouteRender(route) {
  if (!route) return route;
  try {
    const inSkills = Array.isArray(route.recommended_skills) ? route.recommended_skills : [];
    const inAgents = Array.isArray(route.recommended_agents) ? route.recommended_agents : [];
    const skills = inSkills.slice(0, 3);
    const agents = inAgents.slice(0, 2);
    const truncated = (inSkills.length > 3) || (inAgents.length > 2);
    return {
      ...route,
      recommended_skills: skills,
      recommended_agents: agents,
      _render_cap_truncated: truncated || undefined,
    };
  } catch {
    return route;
  }
}

export function formatInjection(route, prompt = '', sigHash = '') {
  if (!route) return '';
  // Re-entry dedupe (INJ-05) — scan the incoming prompt for the exact sentinel.
  if (sentinelScan(prompt)) return '';
  const tier = route.tier || 'low';
  if (tier === 'low') return ''; // true pass-through, no sentinel emitted
  const kind = route.invoke_kind;
  if (!kind) return '';

  // ROUTE-04: render the resolver's fixed native fallback at most once. It has
  // no slash mode, so a fabricated framework command cannot reach the model.
  if (Array.isArray(route.fallback_lines) && route.fallback_lines.length) {
    const lines = route.fallback_lines.slice(0, 1).filter(Boolean);
    if (!lines.length) return '';
    const fallbackReason = 'No framework-specific slash resolved; use a native capability if available.';
    return '\n\n' + assembleBlock({ ...route, mode: '' }, sigHash, fallbackReason, lines);
  }

  // warn kind (any tier): MCP-missing warning, no dispatch.
  if (kind === 'warn') {
    const reasoning = buildReasoning(route);
    const fullBody = [route.warning || 'Agent needs an unwired MCP — wire it first.'];
    const candidates = [];
    candidates.push(assembleBlock(route, sigHash, reasoning, fullBody));
    candidates.push(assembleBlock(route, sigHash, 'MCP-missing agent flagged.', fullBody));
    // If the warning itself is enormous, truncate it to fit under the cap.
    for (const body of candidates) {
      const full = '\n\n' + body;
      if (tokenCount(full) <= TOKEN_CAP) return full;
    }
    // Truncate the warning text to whatever budget remains after the
    // sentinel/reasoning/close scaffolding (~80 chars of overhead → keep
    // the warning itself under ~1700 chars to clear the 500-token cap).
    const overhead = `<!-- router-inject mode= tier= sig=${sigHash} -->\nReasoning: MCP-missing agent flagged.\n\n<!-- /router-inject -->`;
    const overheadTokens = tokenCount('\n\n' + overhead);
    const remaining = Math.max(0, TOKEN_CAP - overheadTokens - 2) * 4; // -2 token safety margin
    const truncatedWarning = String(route.warning || '').slice(0, Math.max(50, remaining));
    const final = assembleBlock(route, sigHash, 'MCP-missing agent flagged.', [truncatedWarning]);
    return '\n\n' + final;
  }

  const reasoning = buildReasoning(route);
  const skills = (route.recommended_skills || []).filter(Boolean);
  const agents = (route.recommended_agents || []).filter(Boolean);
  const primarySkill = skills[0] || null;
  const secondarySkills = skills.slice(1);
  const mode = route.mode || '';

  // Build candidate blocks in priority order; pick the first under the cap.
  // Drop order (INJ-06): agents → secondary skills → trim reasoning → keep
  // sentinel + slash + primary skill only.
  const candidates = [];

  if (kind === 'slash') {
    if (tier === 'high') {
      // Full: slash + primary skill + secondary skills + agents
      const fullBody = [slashLine(route, reasoning)];
      if (primarySkill) fullBody.push(skillLine(primarySkill));
      for (const s of secondarySkills) fullBody.push(skillLine(s));
      for (const a of agents) fullBody.push(agentLine(a));
      candidates.push(assembleBlock(route, sigHash, reasoning, fullBody));

      // Drop agents
      const noAgents = [slashLine(route, reasoning)];
      if (primarySkill) noAgents.push(skillLine(primarySkill));
      for (const s of secondarySkills) noAgents.push(skillLine(s));
      candidates.push(assembleBlock(route, sigHash, reasoning, noAgents));

      // Drop secondary skills
      const minSkills = [slashLine(route, reasoning)];
      if (primarySkill) minSkills.push(skillLine(primarySkill));
      candidates.push(assembleBlock(route, sigHash, reasoning, minSkills));

      // Trim reasoning (keep slash + primary skill)
      const shortReason = `${mode} matches this prompt.`;
      const trimmedBody = [`Run /${mode} ${route.args_hint || ''}`.replace(/\s+$/, '') + ` because ${shortReason}`];
      if (primarySkill) trimmedBody.push(skillLine(primarySkill));
      candidates.push(assembleBlock(route, sigHash, shortReason, trimmedBody));

      // Minimal: sentinel + slash only
      const minReason = `${mode} fits.`;
      candidates.push(assembleBlock(route, sigHash, minReason, [`Run /${mode} because ${minReason}`]));
    } else {
      // Medium tier: text-only suggestion, NO slash instruction line (Pitfall 2).
      const skillsList = skills.join(', ') || 'none';
      const agentsList = agents.join(', ') || 'none';
      const line = `Recommended: /${mode}. Skills: ${skillsList}. Agents: ${agentsList}. Run if fit.`;
      candidates.push(assembleBlock(route, sigHash, reasoning, [line]));
      // Drop agents then secondary skills if over cap
      const noAgentsLine = `Recommended: /${mode}. Skills: ${primarySkill || 'none'}. Run if fit.`;
      candidates.push(assembleBlock(route, sigHash, reasoning, [noAgentsLine]));
      const shortReason = `${mode} matches this prompt.`;
      candidates.push(assembleBlock(route, sigHash, shortReason, [noAgentsLine]));
    }
  } else if (kind === 'skill') {
    if (tier === 'high') {
      const fullBody = [];
      if (primarySkill) fullBody.push(skillLine(primarySkill));
      for (const s of secondarySkills) fullBody.push(skillLine(s));
      for (const a of agents) fullBody.push(agentLine(a));
      candidates.push(assembleBlock(route, sigHash, reasoning, fullBody));
      const noAgents = [];
      if (primarySkill) noAgents.push(skillLine(primarySkill));
      for (const s of secondarySkills) noAgents.push(skillLine(s));
      candidates.push(assembleBlock(route, sigHash, reasoning, noAgents));
      const minSkills = [];
      if (primarySkill) minSkills.push(skillLine(primarySkill));
      candidates.push(assembleBlock(route, sigHash, reasoning, minSkills));
      const shortReason = `${primarySkill || 'skill'} fits this prompt.`;
      candidates.push(assembleBlock(route, sigHash, shortReason, minSkills.length ? [skillLine(primarySkill)] : []));
    } else {
      const line = `Recommended skill: ${primarySkill || 'none'}. Run if fit.`;
      candidates.push(assembleBlock(route, sigHash, reasoning, [line]));
      const shortReason = `${primarySkill || 'skill'} fits.`;
      candidates.push(assembleBlock(route, sigHash, shortReason, [line]));
    }
  } else if (kind === 'agent') {
    if (tier === 'high') {
      const fullBody = [];
      for (const a of agents) fullBody.push(agentLine(a));
      for (const s of skills) fullBody.push(skillLine(s));
      candidates.push(assembleBlock(route, sigHash, reasoning, fullBody));
      const primaryOnly = agents[0] ? [agentLine(agents[0])] : [];
      candidates.push(assembleBlock(route, sigHash, reasoning, primaryOnly));
      const shortReason = `${agents[0] || 'agent'} fits this task.`;
      candidates.push(assembleBlock(route, sigHash, shortReason, primaryOnly));
    } else {
      const a0 = agents[0] || 'none';
      const line = `Recommended agent: ${a0} for this subtask. Dispatch if fit.`;
      candidates.push(assembleBlock(route, sigHash, reasoning, [line]));
      const shortReason = `${a0} fits.`;
      candidates.push(assembleBlock(route, sigHash, shortReason, [line]));
    }
  } else {
    return ''; // unknown kind — pass-through
  }

  for (const body of candidates) {
    const full = '\n\n' + body;
    if (tokenCount(full) <= TOKEN_CAP) return full;
  }
  // Last resort: return the smallest candidate anyway (still bounded).
  const smallest = candidates[candidates.length - 1];
  return '\n\n' + smallest;
}

// --- main pipeline --------------------------------------------------------

function routeToInspectShape(state) {
  const route = state.route || null;
  return {
    normalized_prompt: state.includePrompt ? state.normalizedPrompt : '',
    prompt: state.includePrompt ? state.prompt : undefined,
    candidates: state.candidates || [],
    margin: typeof state.margin === 'number' ? state.margin : null,
    thresholds: state.thresholds || { T_high: null, T_low: null, M: null },
    selected_tier: state.tier || null,
    selected_route: route,
    resolved_slash: state.resolvedSlash || null,
    resolve_quarantined: state.resolveQuarantined || [],
    guards_fired: state.guards_fired || [],
    cache: state.cache || { status: 'miss', key_prefix: '', scoring_skipped: false },
    graphify: state.graphify || { status: 'not_triggered', queried: false, symbols: [] },
    final_injected_context: state.finalInjectedContext || '',
    pass_through_reason: state.passThroughReason || null,
    score_debug: state.score_debug || {
      top_score: null,
      runner_up_score: null,
      margin: typeof state.margin === 'number' ? state.margin : null,
      T_low: state.thresholds ? state.thresholds.T_low : null,
      T_high: state.thresholds ? state.thresholds.T_high : null,
      M: state.thresholds ? state.thresholds.M : null,
      margin_rule_affected_tier: false,
    },
    guard_debug: state.guard_debug || {
      original_route: null,
      final_route: route,
      guards_fired: state.guards_fired || [],
      warning_text: route && route.warning ? route.warning : null,
    },
    decision_trace: state.decision_trace || [],
    // SAF-01: derived mtime fingerprint (mode_map:manifest:weights) for this
    // decision — observable in inspectDecision output and telemetry.
    routing_version: state.routing_version || null,
  };
}

function candidateRows(scored, boosted, blended, modeMap) {
  const rawByName = new Map((scored || []).map((s) => [String(s.name || ''), s]));
  const boostedByName = new Map((boosted || []).map((s) => [String(s.name || ''), s]));
  return (blended || []).slice(0, 8).map((s) => {
    const name = String(s.name || '');
    const raw = rawByName.get(name) || s;
    const boostedRow = boostedByName.get(name) || s;
    const rawScore = Number(raw.score || 0);
    const boostedScore = Number(boostedRow.score || 0);
    const mmEntry = modeMapEntryForName(modeMap, name);
    const row = {
      id: s.entry && s.entry.id ? s.entry.id : name,
      name,
      raw_score: rawScore,
      normalized_score: Number(s.norm || 0),
      weight_applied: typeof s.weight_applied === 'number' ? s.weight_applied : null,
      final_score: Number(s.norm || 0),
      route_target: mmEntry ? {
        id: mmEntry.id || null,
        mode: mmEntry.mode || null,
        invoke_kind: mmEntry.invoke_kind || null,
      } : null,
    };
    if (boostedScore !== rawScore) row.boosted_score = boostedScore;
    return row;
  });
}

function modeMapEntryForName(modeMap, name) {
  const target = String(name || '').toLowerCase();
  if (!target || !modeMap || !Array.isArray(modeMap.entries)) return null;
  return modeMap.entries.find((e) => {
    if (!e) return false;
    if (e.id && String(e.id).toLowerCase() === target) return true;
    if (e.mode && String(e.mode).toLowerCase() === target) return true;
    const recs = [...(e.recommended_skills || []), ...(e.recommended_agents || [])];
    return recs.some((r) => String(r || '').toLowerCase() === target);
  }) || null;
}

export function telemetryEntryFromState(decision, startNs) {
  const guards = decision.guards_fired || [];
  const denyFiltered = guards.includes('deny_filtered');
  const top = decision.top || null;
  const weights = decision.weights || null;
  const entryId = top && top.entry && top.entry.id;
  const ts = Date.now();
  const prompt_signature = denyFiltered ? null : promptSignature(decision.normalizedPrompt, decision.intentKeywords || []);
  const suggested_mode = decision.route ? decision.route.mode : null;
  const suggested_skills = decision.route ? (decision.route.recommended_skills || []) : [];
  const suggested_agents = decision.route ? (decision.route.recommended_agents || []) : [];
  const cache_status = decision.cache?.status || 'miss';
  return {
    ts,
    prompt_signature,
    suggested_mode,
    suggested_skills,
    suggested_agents,
    cache_hit: cache_status === 'hit',
    cache_status,
    suggestion_id: shadowHash({ ts, prompt_signature, runtime: RUNTIME, suggested_mode, suggested_skills, suggested_agents }),
    confidence_tier: decision.tier,
    invoke_kind: decision.invoke_kind || null,
    graphify_queried: decision.graphify ? !!decision.graphify.queried : false,
    graph_status: decision.graphify ? decision.graphify.status || 'not_triggered' : 'not_triggered',
    guards_fired: guards,
    downstream_invocations: null,
    outcome: null,
    latency_ms: Number(process.hrtime.bigint() - startNs) / 1e6,
    weight_applied: top && typeof top.weight_applied === 'number' ? top.weight_applied : null,
    outcomes: weights && weights.weights && entryId && weights.weights[entryId]
      ? { g: weights.weights[entryId].g || 0, b: weights.weights[entryId].b || 0, u: weights.weights[entryId].u || 0 }
      : null,
    evolved_after: decision.evolvedAfter || null,
    surface_status: decision.surface_status || 'unconfigured',
    surface_disabled_count: typeof decision.surface_disabled_count === 'number' ? decision.surface_disabled_count : 0,
    cwd: decision.cwd,
    // SAF-01: derived mtime-fingerprint of the mode-map/manifest/weights mtimes
    // that produced this route's cache key. Observability only — no prompt text.
    routing_version: decision.routing_version || null,
    // D-06 / PARITY-02: every telemetry record carries its active runtime
    // (claude|codex) so shadow-log/per-install correlation can attribute a line
    // to the runtime that produced it. Additive observability field; append-only
    // JSONL via logTelemetry; no prompt text.
    runtime: RUNTIME,
    resolved_slash: decision.resolvedSlash || null,
    resolve_quarantined: decision.resolveQuarantined || [],
  };
}

// Shared dry-run/production route decision helper. Defaults are read-only:
// no cache writes, telemetry appends, stdout emission, or evolution trigger.
export function inspectDecision(prompt, options = {}) {
  const startNs = process.hrtime.bigint();
  const opts = {
    cwd: process.cwd(),
    mutateCache: false,
    logTelemetry: false,
    emitInjection: false,
    bumpEvolution: false,
    includePrompt: false,
    manifestPath: MANIFEST,
    buildScriptPath: BUILD_SCRIPT,
    modeMapPath: MODE_MAP,
    weightsPath: WEIGHTS,
    cachePath: CACHE,
    telemetryPath: TELEMETRY,
    evolutionStatePath: EVOLUTION_STATE,
    evolveTriggerPath: TRIGGER,
    runtimeConfigDir: RUNTIME_CONFIG_DIR,
    ...options,
  };
  const state = {
    prompt: String(prompt || ''),
    includePrompt: !!opts.includePrompt,
    tier: null,
    route: null,
    guards_fired: [],
    invoke_kind: null,
    normalizedPrompt: String(prompt || '').toLowerCase().replace(/\s+/g, ' ').trim(),
    intentKeywords: [],
    candidates: [],
    margin: null,
    thresholds: { T_high: null, T_low: null, M: null },
    cache: { status: 'miss', key_prefix: '', scoring_skipped: false },
    graphify: { status: 'not_triggered', queried: false, symbols: [] },
    score_debug: {
      top_score: null,
      runner_up_score: null,
      margin: null,
      T_low: null,
      T_high: null,
      M: null,
      margin_rule_affected_tier: false,
    },
    guard_debug: {
      original_route: null,
      final_route: null,
      guards_fired: [],
      warning_text: null,
    },
    decision_trace: ['start'],
    finalInjectedContext: '',
    passThroughReason: null,
    resolvedSlash: null,
    resolveQuarantined: [],
    surface_status: 'unconfigured',
    surface_disabled_count: 0,
    cwd: opts.cwd,
    modeMap: null,
  };

  const finish = () => {
    const out = routeToInspectShape(state);
    const readOnlyInspect = !opts.mutateCache && !opts.logTelemetry && !opts.emitInjection && !opts.bumpEvolution;
    if (readOnlyInspect || opts.includeEvolutionVisibility) {
      out.evolution_visibility = summarizeEvolutionVisibility({
        modeMap: state.modeMap,
        modeMapPath: opts.modeMapPath,
        weights: state.weights || opts.weights || null,
        weightsPath: opts.weightsPath,
        evolutionStatePath: opts.evolutionStatePath,
        triggerPath: opts.evolveTriggerPath,
        telemetryPath: opts.telemetryPath,
        selectedEntryId: state.route && state.route.id ? state.route.id : null,
        candidates: out.candidates || [],
      });
    }
    out.telemetry_entry = state.tier !== null ? telemetryEntryFromState(state, startNs) : null;
    if (opts.logTelemetry && out.telemetry_entry) logTelemetry(out.telemetry_entry, opts.telemetryPath);
    if (opts.emitInjection && state.finalInjectedContext) emit(state.finalInjectedContext);
    if (opts.bumpEvolution) { try { bumpEvolveTrigger(); } catch {} }
    return out;
  };

  try {
    if (typeof prompt !== 'string') {
      state.passThroughReason = 'invalid_prompt';
      return finish();
    }
    if (process.env.ROUTER_TEST_THROW === '1') {
      throw new Error('ROUTER_TEST_THROW forced throw');
    }
    if (trivialPromptDetect(prompt)) {
      state.tier = 'trivial';
      state.passThroughReason = 'trivial';
      state.decision_trace.push('pass_through:trivial');
      return finish();
    }
    if (explicitOverrideDetect(prompt).override) {
      state.tier = 'user_explicit';
      state.passThroughReason = 'user_explicit';
      state.decision_trace.push('pass_through:user_explicit');
      return finish();
    }
    if (sentinelScan(prompt)) {
      state.tier = 'reentry_skipped';
      state.passThroughReason = 'reentry_skipped';
      state.decision_trace.push('pass_through:reentry_skipped');
      return finish();
    }

    const hasFixtureObjects = Object.hasOwn(opts, 'manifest') || Object.hasOwn(opts, 'modeMap');
    let fresh;
    if (hasFixtureObjects) {
      fresh = { status: 'fresh' };
    } else if (process.env.ROUTER_TEST_FRESHNESS) {
      const forced = process.env.ROUTER_TEST_FRESHNESS;
      if (forced === 'stale') fresh = { status: 'stale', reminder: STALE_REMINDER };
      else if (forced === 'manifest_missing') fresh = { status: 'manifest_missing' };
      else fresh = { status: 'fresh' };
    } else {
      fresh = checkFreshness(opts.manifestPath, opts.buildScriptPath);
    }
    if (fresh.status === 'stale' && fresh.reminder) {
      state.tier = 'stale';
      state.passThroughReason = 'stale';
      state.finalInjectedContext = fresh.reminder;
      state.decision_trace.push('pass_through:stale');
      return finish();
    }
    if (fresh.status !== 'fresh') {
      state.tier = fresh.status;
      state.passThroughReason = fresh.status;
      state.decision_trace.push(`pass_through:${fresh.status}`);
      return finish();
    }

    const manifest = Object.hasOwn(opts, 'manifest') ? opts.manifest : loadManifest(opts.manifestPath);
    const modeMap = Object.hasOwn(opts, 'modeMap') ? opts.modeMap : loadModeMap(opts.modeMapPath);
    state.modeMap = modeMap;
    if (!manifest || !modeMap) {
      state.tier = 'manifest_missing';
      state.passThroughReason = 'manifest_missing';
      state.decision_trace.push('pass_through:manifest_missing');
      return finish();
    }
    // INVC-03: epoch-guarded threshold consult. Runs AFTER manifest is loaded
    // (fingerprint known). A calibration file whose manifest_fingerprint matches
    // wins; mismatch/absent/corrupt → mode-map defaults (0.591/0.291/0.191) win,
    // never stale per-install thresholds. Read-only — routes through
    // loadEpochCalibration which never mutates the calibration file.
    const epochCal = loadEpochCalibration(
      opts.manifestFingerprint ?? manifest.manifest_fingerprint ?? '0',
      {
        calibrationPath: opts.calibrationPath,
        modeMapVersion: modeMap?.schema_version ?? modeMap?.version ?? null,
      },
    );
    state.thresholds = epochCal.matched
      ? epochCal.thresholds
      : (modeMap.thresholds || { T_high: 0.591, T_low: 0.291, M: 0.191 });
    state.score_debug.T_low = state.thresholds.T_low;
    state.score_debug.T_high = state.thresholds.T_high;
    state.score_debug.M = state.thresholds.M;
    setModeMapForBlend(modeMap);
    const weights = Object.hasOwn(opts, 'weights') ? opts.weights : loadWeights(opts.weightsPath);
    state.weights = weights;
    const blendFactor = (weights && typeof weights.blend === 'number') ? weights.blend : 0.15;
    state.evolvedAfter = (() => {
      try { return new Date(statSync(opts.modeMapPath).mtimeMs).toISOString(); }
      catch { return null; }
    })();

    const knownNames = buildKnownNames(modeMap);
    if (explicitOverrideDetect(prompt, knownNames).override) {
      state.tier = 'user_explicit';
      state.passThroughReason = 'user_explicit';
      state.decision_trace.push('pass_through:user_explicit');
      return finish();
    }

    const graph = graphifyHeuristic(prompt, opts.cwd);
    const graphMtime = opts.graphMtime ?? readGraphMtime(opts.cwd);
    state.graphify = {
      queried: !!graph.queried,
      status: graph.status || 'not_triggered',
      symbols: graph.symbols || [],
      boost_ids: Array.from(graph.boostIds || []).sort(),
      boost_count: graph.boostIds && typeof graph.boostIds.size === 'number' ? graph.boostIds.size : 0,
      elapsed_ms: graph.elapsed_ms || 0,
      graph_mtime: graphMtime,
    };
    // INVC-02: cache key folds the manifest fingerprint epoch, not mtimes, so a
    // no-op rebuild keeps the key (cache preserved) while any semantic inventory
    // change bumps it (stale route recomputed). Fail-open default is '0'.
    const manifestFingerprint = opts.manifestFingerprint ?? manifest.manifest_fingerprint ?? '0';
    // WR-01/WR-02: fold LIVE content hashes (NOT mtimes) of the loaded mode-map,
    // weights, and graph into the key. These inputs are read fresh every decision
    // and do not trigger a manifest rebuild on edit (watcher ignores router/;
    // graph is project-side), so without this fold an edit would serve stale
    // cached routes. Content-addressed => deterministic + fail-open ('' skips).
    const modeMapHash = contentHash(modeMap);
    const weightsHash = contentHash(weights);
    const graphHash = (graph && graph.content_hash) || '';
    const sig = cacheKey(state.normalizedPrompt, [], manifestFingerprint, modeMapHash, weightsHash, graphHash, RUNTIME);
    state.cache.key_prefix = sig.slice(0, 8);
    state.cache.invalidation_epoch = { manifest_fingerprint: manifestFingerprint };
    // SAF-01: routing_version is a DERIVED observability string (not stored on
    // disk) exposing the fingerprint epoch — logged in telemetry so a stale-cache
    // diagnosis can correlate a cache miss/hit with the epoch that produced the
    // key. Contains no prompt text or secret material.
    state.routing_version = manifestFingerprint;
    const cache = loadCache(opts.cachePath);
    const cached = cacheLookup(sig, cache);
    if (cached && !routeTargetsExist(cached, manifest, modeMap)) {
      // SAF-02: cached route references a target id/skill/agent that is absent
      // from the current manifest (removed or renamed since the entry was
      // written). Do NOT serve the stale entry — fall through to recompute.
      state.cache.status = 'stale_target_recompute';
      state.cache.cached_route = cached;
      state.decision_trace.push('cache:stale_target');
    } else if (cached) {
      state.tier = cached.tier || 'high';
      state.route = cached;
      state.invoke_kind = cached.invoke_kind;
      state.cache.status = 'hit';
      state.cache.scoring_skipped = true;
      state.cache.cached_route = cached;
      state.passThroughReason = 'cache_hit_scoring_skipped';
      state.decision_trace.push('cache:hit', 'scoring:skipped');
      // SAF-04: cap render counts before formatInjection on the cache-hit path.
      const capped = capRouteRender(cached);
      if (capped._render_cap_truncated) state.decision_trace.push('render:cap_truncated');
      delete capped._render_cap_truncated; // telemetry-only flag, strip before injection
      const routeBlock = formatInjection(capped, prompt, sig.slice(0, 8));
      const graphBlock = state.graphify.symbols.length ? formatGraphBlock(state.graphify.symbols) : '';
      state.finalInjectedContext = composeWithCap(routeBlock, graphBlock);
      return finish();
    }
    state.decision_trace.push('cache:miss');

    const corpus = buildCorpus(manifest, modeMap, opts.cwd);
    const _sf = applySurfaceFilter(corpus, manifest, modeMap, opts.runtimeConfigDir);
    state.surface_status = _sf.surface_status;
    state.surface_disabled_count = _sf.surface_disabled_count;
    const filteredCorpus = _sf.corpus;
    const queryTokens = tokenize(prompt);
    const scored = bm25Score(queryTokens, filteredCorpus);
    const manifestIdSet = new Set((filteredCorpus || []).map((c) => String(c.name || '').toLowerCase()));
    const boosted = (graph.boostIds && graph.boostIds.size > 0)
      ? applyGraphBoost(scored, graph.boostIds, manifestIdSet, GRAPH_BOOST)
      : scored;
    const normed = normalize(boosted);
    const blended = applyWeightBlend(normed, weights, blendFactor);
    state.candidates = candidateRows(scored, boosted, blended, modeMap);
    if (blended.length === 0) {
      state.tier = 'low';
      state.passThroughReason = 'low_no_match';
      state.decision_trace.push('score:no_match');
      return finish();
    }

    const top = blended[0];
    const runnerUp = blended[1];
    state.top = top;
    state.margin = (top ? top.norm : 0) - (runnerUp ? runnerUp.norm : 0);
    state.score_debug.top_score = top ? top.norm : null;
    state.score_debug.runner_up_score = runnerUp ? runnerUp.norm : null;
    state.score_debug.margin = state.margin;
    const topName = String(top.name || '').toLowerCase();
    const hasCanonicalMatch = !!(modeMap && Array.isArray(modeMap.entries)
      && modeMap.entries.some((e) => {
        if (!e) return false;
        const ids = [e.id, e.mode].filter(Boolean).map((x) => String(x).toLowerCase());
        if (ids.includes(topName)) return true;
        const recs = [...(e.recommended_skills || []), ...(e.recommended_agents || [])]
          .filter(Boolean).map((x) => String(x).toLowerCase());
        return recs.includes(topName);
      }));
    const tier = confidenceTier(top.norm, runnerUp ? runnerUp.norm : 0, state.thresholds, hasCanonicalMatch);
    state.tier = tier;
    state.score_debug.margin_rule_affected_tier = (
      tier === 'low'
      && top.norm >= (state.thresholds.T_high || 0)
      && state.margin < (state.thresholds.M || 0)
    );
    state.decision_trace.push(`score:tier:${tier}`);
    if (tier === 'low') {
      state.passThroughReason = state.margin < (state.thresholds.M || 0) ? 'margin_tie' : 'low_threshold';
    }

    const mmEntry = modeMapEntryForName(modeMap, topName);
    let route = {
      id: mmEntry ? mmEntry.id || null : null,
      mode: mmEntry ? mmEntry.mode : null,
      invoke_kind: mmEntry ? mmEntry.invoke_kind : null,
      recommended_skills: mmEntry ? mmEntry.recommended_skills : [],
      recommended_agents: mmEntry ? mmEntry.recommended_agents : [],
      tier,
      args_hint: mmEntry ? mmEntry.args_hint : null,
      warning: mmEntry ? mmEntry.warning || null : null,
      weight_applied: typeof top.weight_applied === 'number' ? top.weight_applied : null,
      scores: blended.slice(0, 3).map((s) => ({ name: s.name, norm: s.norm })),
    };
    if (route.invoke_kind === 'slash') {
      const resolved = resolveSlashRoute(mmEntry, manifest, { tier });
      state.resolvedSlash = resolved?.suggested_slash || null;
      state.resolveQuarantined = Array.isArray(resolved?.quarantined)
        ? resolved.quarantined.slice()
        : [];
      if (resolved?.suggested_slash) {
        route.mode = resolved.suggested_slash;
        route.tier = resolved.tier || route.tier;
        route.resolved_slash = resolved.suggested_slash;
        route.resolve_quarantined = state.resolveQuarantined;
        state.tier = route.tier;
        state.decision_trace.push(`resolve:slash:${resolved.suggested_slash}`);
      } else if (Array.isArray(resolved?.fallback_lines) && resolved.fallback_lines.length) {
        route.mode = null;
        route.tier = resolved.tier || route.tier;
        route.fallback_lines = resolved.fallback_lines.slice(0, 1);
        route.resolve_quarantined = state.resolveQuarantined;
        state.tier = route.tier;
        state.decision_trace.push('resolve:fallback:native');
      } else {
        route = null;
        state.tier = 'low';
        state.passThroughReason = 'resolve_unavailable';
        state.decision_trace.push('resolve:slash:unavailable');
      }
    }
    state.route = route;
    state.invoke_kind = route ? route.invoke_kind : null;
    state.guard_debug.original_route = route;

    const guarded = applyGuards(route, prompt, manifest, modeMap, {
      queryTokens,
      thresholds: state.thresholds,
      autoTopScore: top.score,
    });
    const finalRoute = guarded.route;
    state.guards_fired = guarded.guards_fired;
    state.guard_debug.guards_fired = guarded.guards_fired;
    state.guard_debug.final_route = finalRoute;
    state.guard_debug.warning_text = finalRoute && finalRoute.warning ? finalRoute.warning : null;
    if (guarded.guards_fired.includes('deny_filtered')) {
      state.tier = 'deny_filtered';
      state.route = null;
      state.invoke_kind = null;
      state.passThroughReason = 'deny_filtered';
      state.guard_debug.final_route = null;
      state.decision_trace.push('guard:deny_filtered');
      return finish();
    }
    if (guarded.guards_fired.length) state.decision_trace.push('guard:demoted_or_filtered');

    if (finalRoute && finalRoute.tier === 'high' && finalRoute.invoke_kind !== 'warn' && opts.mutateCache) {
      writeCache(cache, sig, finalRoute);
      try { saveCache(cache, opts.cachePath); } catch {}
    }

    if (finalRoute) {
      // SAF-04: cap render counts before formatInjection on the fresh-route
      // path. The uncapped finalRoute was already written to cache above (so
      // future cache hits hold the full author-priority lists); only the
      // rendered injection is capped.
      const capped = capRouteRender(finalRoute);
      if (capped._render_cap_truncated) state.decision_trace.push('render:cap_truncated');
      delete capped._render_cap_truncated; // telemetry-only flag, strip before injection
      state.route = capped;
      state.invoke_kind = capped.invoke_kind;
      if (capped.invoke_kind === 'warn') state.passThroughReason = null;
      const routeBlock = formatInjection(capped, prompt, sig.slice(0, 8));
      const graphBlock = state.graphify.symbols.length ? formatGraphBlock(state.graphify.symbols) : '';
      state.finalInjectedContext = composeWithCap(routeBlock, graphBlock);
      if (!state.finalInjectedContext && state.tier === 'low' && !state.passThroughReason) state.passThroughReason = 'low_tier';
    } else {
      state.route = null;
      state.invoke_kind = null;
      if (!state.passThroughReason) state.passThroughReason = 'guard_dropped';
    }
    return finish();
  } catch {
    state.tier = 'error';
    state.passThroughReason = 'error';
    return finish();
  }
}

function main(payload, { additionalContext = '', skipRouting = false } = {}) {
  const startNs = process.hrtime.bigint();
  if (typeof globalThis.__routerStartNs === 'undefined') globalThis.__routerStartNs = startNs;
  const prompt = payload?.prompt ?? payload?.message;
  if (payload?.hook_event_name && payload.hook_event_name !== 'UserPromptSubmit') {
    try {
      const observerManifest = loadManifest();
      const observerModeMap = loadModeMap();
      observeShadowEvent(payload, {
        manifestFingerprint: observerManifest?.manifest_fingerprint || '',
        modeMapVersion: observerModeMap?.schema_version ?? observerModeMap?.version ?? 'unknown',
      });
    } catch { /* observer is strictly fail-open */ }
    return;
  }
  if (!payload || typeof prompt !== 'string') return;
  const decision = skipRouting ? { final_injected_context: '', pass_through_reason: 'context_handled' } : inspectDecision(prompt, {
    cwd: process.cwd(),
    mutateCache: true,
    logTelemetry: true,
    emitInjection: false,
    includePrompt: false,
  });
  const coverageFreshness = process.env.ROUTER_TEST_COVERAGE_FRESHNESS
    ? { status: process.env.ROUTER_TEST_COVERAGE_FRESHNESS, reminder: COVERAGE_REMINDER }
    : checkCoverageFreshness();
  const coverageReminder = ['trivial', 'error', 'invalid_prompt']
    .includes(decision.pass_through_reason)
    ? ''
    : coverageFreshness.status === 'fresh' ? '' : coverageFreshness.reminder;
  const composed = [
    decision.final_injected_context,
    additionalContext,
    coverageReminder,
  ].filter(Boolean).join('\n\n');
  if (composed) emit(composed);
  return { additionalContext: composed };
}

export function explainLastDecision(options = {}) {
  const telemetryPath = options.telemetryPath || TELEMETRY;
  let latest = null;
  try {
    if (!existsSync(telemetryPath)) return explainLastStatus('missing');
    const lines = readFileSync(telemetryPath, 'utf8').split(/\r?\n/).filter(Boolean);
    for (let i = lines.length - 1; i >= 0; i--) {
      try { latest = JSON.parse(lines[i]); break; } catch {}
    }
  } catch {
    return explainLastStatus('error');
  }
  if (!latest) return explainLastStatus('empty');
  const selectedRoute = {
    mode: latest.suggested_mode || null,
    invoke_kind: latest.invoke_kind || null,
    recommended_skills: Array.isArray(latest.suggested_skills) ? latest.suggested_skills : [],
    recommended_agents: Array.isArray(latest.suggested_agents) ? latest.suggested_agents : [],
  };
  const decision = {
    ts: latest.ts || null,
    prompt_signature: latest.prompt_signature || null,
    selected_route: selectedRoute,
    suggested_mode: latest.suggested_mode || null,
    suggested_skills: selectedRoute.recommended_skills,
    suggested_agents: selectedRoute.recommended_agents,
    confidence_tier: latest.confidence_tier || null,
    invoke_kind: latest.invoke_kind || null,
    graphify_queried: !!latest.graphify_queried,
    graph_status: latest.graph_status || 'not_triggered',
    guards_fired: Array.isArray(latest.guards_fired) ? latest.guards_fired : [],
    latency_ms: typeof latest.latency_ms === 'number' ? latest.latency_ms : null,
    weight_applied: typeof latest.weight_applied === 'number' ? latest.weight_applied : null,
    outcomes: latest.outcomes || null,
    evolved_after: latest.evolved_after || null,
    surface_status: latest.surface_status || 'unconfigured',
    surface_disabled_count: typeof latest.surface_disabled_count === 'number' ? latest.surface_disabled_count : 0,
    cwd: latest.cwd || null,
    outcome: latest.outcome ?? null,
    downstream_invocations: latest.downstream_invocations ?? null,
  };
  const privacy = {
    raw_prompt_stored: false,
    raw_prompt_available: false,
    note: 'raw prompt text is unavailable by design; telemetry stores prompt signatures and route metadata only',
  };
  return {
    status: 'ok',
    decision,
    privacy,
    ts: decision.ts,
    prompt_signature: decision.prompt_signature,
    selected_route: decision.selected_route,
    suggested_mode: decision.suggested_mode,
    suggested_skills: decision.suggested_skills,
    suggested_agents: decision.suggested_agents,
    confidence_tier: decision.confidence_tier,
    invoke_kind: decision.invoke_kind,
    graphify_queried: decision.graphify_queried,
    graph_status: decision.graph_status,
    graphify: {
      queried: decision.graphify_queried,
      status: decision.graph_status,
    },
    guards_fired: decision.guards_fired,
    latency_ms: decision.latency_ms,
    weight_applied: decision.weight_applied,
    outcomes: decision.outcomes,
    evolved_after: decision.evolved_after,
    surface_status: decision.surface_status,
    surface_disabled_count: decision.surface_disabled_count,
    cwd: decision.cwd,
    privacy_note: privacy.note,
  };
}

function explainLastStatus(status) {
  const privacy = {
    raw_prompt_stored: false,
    raw_prompt_available: false,
    note: 'raw prompt text is unavailable by design; telemetry stores prompt signatures and route metadata only',
  };
  return {
    status,
    decision: null,
    privacy,
    prompt_signature: null,
    selected_route: null,
    confidence_tier: null,
    privacy_note: privacy.note,
  };
}

function cliPrompt(args) {
  const filtered = args.filter((a) => a !== '--json');
  return filtered.join(' ').trim();
}

function runCli(argv) {
  const [cmd, ...args] = argv;
  if (cmd === 'inspect' || cmd === 'preview') {
    const prompt = cliPrompt(args);
    if (!prompt) {
      writeSync(1, JSON.stringify({
        status: 'error',
        error: 'missing_prompt',
        command: cmd,
      }, null, args.includes('--json') ? 0 : 2));
      return 1;
    }
    const out = inspectDecision(cliPrompt(args), {
      cwd: process.cwd(),
      mutateCache: false,
      logTelemetry: false,
      emitInjection: false,
      bumpEvolution: false,
      includePrompt: true,
      cachePath: process.env.ROUTER_TEST_CACHE_PATH || CACHE,
      telemetryPath: process.env.ROUTER_TEST_TELEMETRY_PATH || TELEMETRY,
      weightsPath: process.env.ROUTER_TEST_WEIGHTS_PATH || WEIGHTS,
      evolutionStatePath: process.env.ROUTER_TEST_EVOLUTION_STATE_PATH || EVOLUTION_STATE,
      evolveTriggerPath: process.env.ROUTER_TEST_EVOLVE_TRIGGER_PATH || TRIGGER,
    });
    if (cmd === 'preview') {
      out.preview = true;
      out.dry_run = true;
      out.mutations = {
        cache: false,
        telemetry: false,
        evolution_trigger: false,
        emitted_to_hook: false,
      };
    }
    writeSync(1,JSON.stringify(out, null, args.includes('--json') ? 0 : 2));
    return true;
  }
  if (cmd === 'proposals' || cmd === 'proposal' || cmd === 'evolve-proposals') {
    const out = buildTelemetryProposals({
      telemetryPath: process.env.ROUTER_TEST_TELEMETRY_PATH || TELEMETRY,
      modeMapPath: process.env.ROUTER_TEST_MODE_MAP_PATH || MODE_MAP,
      weightsPath: process.env.ROUTER_TEST_WEIGHTS_PATH || WEIGHTS,
      evolutionStatePath: process.env.ROUTER_TEST_EVOLUTION_STATE_PATH || EVOLUTION_STATE,
      triggerPath: process.env.ROUTER_TEST_EVOLVE_TRIGGER_PATH || TRIGGER,
    });
    writeSync(1,JSON.stringify(out, null, args.includes('--json') ? 0 : 2));
    return true;
  }
  if (cmd === 'explain-last') {
    writeSync(1,JSON.stringify(explainLastDecision(), null, args.includes('--json') ? 0 : 2));
    return true;
  }
  if (cmd === 'routes') {
    writeSync(1,JSON.stringify(listRoutes(loadManifest() || {}, loadModeMap() || {}), null, args.includes('--json') ? 0 : 2));
    return true;
  }
  if (cmd === 'unmapped') {
    writeSync(1,JSON.stringify(listUnmapped(loadManifest() || {}, loadModeMap() || {}), null, args.includes('--json') ? 0 : 2));
    return true;
  }
  if (cmd === 'coverage') {
    writeSync(1,JSON.stringify(summarizeCoverage(loadManifest() || {}, loadModeMap() || {}), null, args.includes('--json') ? 0 : 2));
    return true;
  }
  if (cmd === 'doctor' || cmd === 'health') {
    writeSync(1,JSON.stringify(diagnoseRouterState(), null, args.includes('--json') ? 0 : 2));
    return true;
  }
  return false;
}

function emit(additionalContext) {
  writeSync(1,JSON.stringify({
    hookSpecificOutput: {
      hookEventName: 'UserPromptSubmit',
      additionalContext,
    },
  }));
}

// --- entry point: outer try/catch = fail-open belt-and-braces -------------
// Only runs when this file is executed directly (as a hook), not when
// imported as a module by tests (isMain() guard prevents stdin listeners
// from hanging the test runner).

if (isMain()) {
  const cliResult = runCli(process.argv.slice(2));
  if (cliResult) {
    process.exit(cliResult === 1 ? 1 : 0);
  }
  readStdin(async (input) => {
    let payload;
    try {
      payload = JSON.parse(input);
    } catch {
      process.exit(0); // malformed stdin -> pass-through
      return;
    }
    try {
      const prompt = payload?.prompt ?? payload?.message;
      const ownedRoot = process.env.ROUTER_CONTEXT_OWNED_ROOT || ROUTER_DIR;
      const projectRoot = process.env.ROUTER_CONTEXT_PROJECT_ROOT || process.cwd();
      const modulePath = process.env.ROUTER_CONTEXT_MODULE_PATH
        || join(ROUTER_DIR, 'modules', 'context', 'prompt-route.mjs');
      const { routeContextPrompt } = await import(modulePath);
      const routed = routeContextPrompt({ prompt, ownedRoot, projectRoot });
      const emitted = main(payload, { additionalContext: routed.additional_context || '', skipRouting: routed.handled === true });
      if (routed.startup_notice_emitted && emitted.additionalContext) {
        try {
          const ackPath = process.env.ROUTER_STARTUP_ACK_MODULE_PATH
            || join(ROUTER_DIR, 'modules', 'steward', 'startup-ack.mjs');
          const { acknowledgeStartupNotice } = await import(ackPath);
          const { loadStartupPointer } = await import(
            process.env.ROUTER_STARTUP_POINTER_MODULE_PATH
              || join(ROUTER_DIR, 'modules', 'steward', 'startup-pointer.mjs')
          );
          acknowledgeStartupNotice({ ownedRoot, pointer: routed.startup_notice_pointer });
        } catch {}
      }
    } catch {
      // fail-open: emit nothing, never exit code 2, never a block decision
    }
    // Phase 3 / EVO-02: bump the evolve trigger counter; spawn the worker on
    // counter % 200 === 0 (non-blocking via spawn().unref()). Non-blocking
    // and try/catch-wrapped so any error in the trigger path is a no-op.
    // Production mutation is handled inside inspectDecision({ bumpEvolution:true }) for CLI-safe gating.
    try { bumpEvolveTrigger(); } catch {}
    // Debug-only latency line (guarded by env so production is silent).
    // Consumed by tests/router.perf.test.mjs to assert in-process < 100ms.
    if (process.env.ROUTER_DEBUG_LATENCY === '1' && globalThis.__routerStartNs) {
      const ms = Number(process.hrtime.bigint() - globalThis.__routerStartNs) / 1e6;
      process.stderr.write(`__router_latency_ms=${ms}\n`);
    }
    process.exit(0);
  });
}
